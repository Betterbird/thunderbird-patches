Branding: add warning when l10n directory in .mozbuild is missing.

diff --git a/mail/locales/Makefile.in b/mail/locales/Makefile.in
--- a/mail/locales/Makefile.in
+++ b/mail/locales/Makefile.in
@@ -75,8 +75,27 @@ endif
 # tinderbox scripts. Alter it with caution.
 
 installers-%: IS_LANGUAGE_REPACK=1
 installers-%:
+	@if test ! -d '$(L10NBASEDIR)/$*'; then \
+		echo '***************************************************************'; \
+		echo 'WARNING: Localisation base directory is missing:'; \
+		echo '  $(L10NBASEDIR)/$*'; \
+		echo 'The build will silently fall back to en-US strings.'; \
+		echo '***************************************************************'; \
+	fi
+	@if test ! -d '$(dir $(L10NBASEDIR))thunderbird-l10n/$*'; then \
+		echo '***************************************************************'; \
+		echo 'WARNING: thunderbird-l10n checkout is missing:'; \
+		echo '  $(dir $(L10NBASEDIR))thunderbird-l10n/$*'; \
+		echo '***************************************************************'; \
+	fi
+	@if test ! -d '$(L10NBASEDIR)/$*/mail'; then \
+		echo '***************************************************************'; \
+		echo 'WARNING: No mail content copied into $(L10NBASEDIR)/$*.'; \
+		echo 'See the setup instructions in 05b-branding-localised-installer.patch.'; \
+		echo '***************************************************************'; \
+	fi
 	@$(MAKE) clobber-$*
 	@$(MAKE) l10n-$*
 	@$(MAKE) package-langpack-$*
 	@$(MAKE) repackage-zip-$*
