Bug 2060804 - Fix "Settings" menu for old Macs. r=aleca

Fix oversight from bug 2013725.

Differential Revision: https://phabricator.services.mozilla.com/D320122


diff --git a/mail/base/content/messenger-menubar.inc.xhtml b/mail/base/content/messenger-menubar.inc.xhtml
--- a/mail/base/content/messenger-menubar.inc.xhtml
+++ b/mail/base/content/messenger-menubar.inc.xhtml
@@ -1241,17 +1241,17 @@
 #else
 #ifdef XP_MACOSX
     <menuseparator id="prefSep"/>
     <!-- macOS 13 changed "Preferences" to "Settings" so one of these gets picked.
          We don't differentiate but we need to add both IDs. -->
     <menuitem id="menu_preferences"
               data-l10n-id="menu-tools-settings"
               key="key_preferencesCmdMac"
-              oncommand="openOptionsDialog()"/>
+              oncommand="openPreferencesTab()"/>
     <menuitem id="menu_settings"
               data-l10n-id="menu-tools-settings"
               key="key_preferencesCmdMac"
               oncommand="openPreferencesTab()"/>
     <menuitem id="menu_accountmgr"
               label="&accountManagerCmd2.label;"
               accesskey="&accountManagerCmd2.accesskey;"
               oncommand="MsgAccountManager(null);"/>

