      * @param {integer} aLevel
      * @param {nsIAuthInformation} aAuthInfo
      * @returns {boolean}
      */
     promptAuth(aChannel, aLevel, aAuthInfo) {
+      // The channel URI is the server, not the proxy, so everything below would
