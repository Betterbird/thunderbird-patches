Bug 2081766 - Use a Set for RSS and Atom category duplicate checks. r=tobyp

FeedParser checked each category against the item's earlier keywords with
includes(), which made parsing quadratic in the number of categories in an item.

Differential Revision: https://phabricator.services.mozilla.com/D336252

diff --git a/mailnews/extensions/newsblog/FeedParser.sys.mjs b/mailnews/extensions/newsblog/FeedParser.sys.mjs
--- a/mailnews/extensions/newsblog/FeedParser.sys.mjs
+++ b/mailnews/extensions/newsblog/FeedParser.sys.mjs
@@ -362,13 +362,15 @@ FeedParser.prototype = {
 
       // Support <category> and autotagging.
       tags = this.childrenByTagNameNS(itemNode, nsURI, "category");
       if (tags) {
+        const terms = new Set();
         for (const tag of tags) {
           let term = this.getNodeValue(tag);
           term = term ? this.xmlUnescape(term.replace(/,/g, ";")) : null;
-          if (term && !item.keywords.includes(term)) {
+          if (term && !terms.has(term)) {
             item.keywords.push(term);
+            terms.add(term);
           }
         }
       }
 
@@ -1090,13 +1092,15 @@ FeedParser.prototype = {
         lazy.FeedUtils.ATOM_IETF_NS,
         "category"
       );
       if (tags) {
+        const terms = new Set();
         for (const tag of tags) {
           let term = this.removeUnprintableASCII(tag.getAttribute("term"));
           term = term ? this.xmlUnescape(term.replace(/,/g, ";")).trim() : null;
-          if (term && !item.keywords.includes(term)) {
+          if (term && !terms.has(term)) {
             item.keywords.push(term);
+            terms.add(term);
           }
         }
       }
 
