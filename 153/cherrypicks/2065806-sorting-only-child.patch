--- a/mail/test/browser/folder-display/browser_deletionFromThreads.js
+++ b/mail/test/browser/folder-display/browser_deletionFromThreads.js
@@ -437,8 +437,86 @@ add_task(async function test_cross_tab_p
     !dbViewTab2.isContainer(0),
