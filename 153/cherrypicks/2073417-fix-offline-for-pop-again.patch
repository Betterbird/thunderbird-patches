Bug 2073417 - Suppress offline errors from POP3 biff. r=mkmelin

Return offline failures through the XPCOM result code so direct POP3 retrieval still fails without logging a JavaScript exception. Treat the expected result as a no-op during biff and update the regression test.

Differential Revision: https://phabricator.services.mozilla.com/D339548

diff --git a/mailnews/local/src/Pop3IncomingServer.sys.mjs b/mailnews/local/src/Pop3IncomingServer.sys.mjs
--- a/mailnews/local/src/Pop3IncomingServer.sys.mjs
+++ b/mailnews/local/src/Pop3IncomingServer.sys.mjs
@@ -119,17 +119,20 @@ export class Pop3IncomingServer extends 
     const inbox = this.rootMsgFolder.getFolderWithFlags(
       Ci.nsMsgFolderFlags.Inbox
     );
     const urlListener = inbox.QueryInterface(Ci.nsIUrlListener);
+
     try {
-      // Occurs on biff for an individual server.
       if (this.downloadOnBiff) {
         MailServices.pop3.GetNewMail(msgWindow, urlListener, inbox, this);
       } else {
         MailServices.pop3.CheckForNewMail(msgWindow, urlListener, inbox, this);
       }
     } catch (error) {
       this.performingBiff = false;
+      if (error.result == Cr.NS_MSG_ERROR_OFFLINE) {
+        return;
+      }
       throw error;
     }
   }
 
diff --git a/mailnews/local/src/Pop3Service.sys.mjs b/mailnews/local/src/Pop3Service.sys.mjs
--- a/mailnews/local/src/Pop3Service.sys.mjs
+++ b/mailnews/local/src/Pop3Service.sys.mjs
@@ -59,12 +59,12 @@ export class Pop3Service {
   }
 
   _getMail(downloadNewMail, msgWindow, urlListener, inbox, server) {
     if (Services.io.offline) {
-      throw Components.Exception(
-        "Cannot get mail while offline",
-        Cr.NS_MSG_ERROR_OFFLINE
-      );
+      // Return an XPCOM failure without logging an exception in this service.
+      // XPConnect converts the failure into an exception for JavaScript callers.
+      Components.returnCode = Cr.NS_MSG_ERROR_OFFLINE;
+      return;
     }
     server.wrappedJSObject.withClient(client => {
       client.runningUri.msgWindow = msgWindow;
       client.urlListener = urlListener;
