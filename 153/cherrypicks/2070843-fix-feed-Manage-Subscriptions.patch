Bug 2070843 - Fix feed Manage Subscriptions button. r=darktrojan

Neeed to use `window.browsingContext.topChromeWindow` instead of `top` as it's opened from a content browser.

Differential Revision: https://phabricator.services.mozilla.com/D325127

diff --git a/mail/base/content/modules/SubscribeCommands.mjs b/mail/base/content/modules/SubscribeCommands.mjs
--- a/mail/base/content/modules/SubscribeCommands.mjs
+++ b/mail/base/content/modules/SubscribeCommands.mjs
@@ -46,9 +46,9 @@ function MsgSubscribe(selectedFolder) {
     // Open feed subscription dialog.
     openSubscriptionsDialog(selectedFolder);
   } else {
     // Open IMAP/NNTP subscription dialog.
-    top.openDialog(
+    window.browsingContext.topChromeWindow.openDialog(
       "chrome://messenger/content/subscribe.xhtml",
       "subscribe",
       "chrome,modal,titlebar,resizable=yes",
       {
@@ -75,9 +75,9 @@ function openSubscriptionsDialog(selecte
     );
 
     subscriptionsWindow.focus();
   } else {
-    top.openDialog(
+    window.browsingContext.topChromeWindow.openDialog(
       "chrome://messenger-newsblog/content/feed-subscriptions.xhtml",
       "",
       "centerscreen,chrome,dialog=no,resizable",
       { folder: selectedFolder }
@@ -135,9 +135,15 @@ function MsgUnsubscribe(folder) {
   const dialogMsg = bundle.formatStringFromName("confirmUnsubscribeText", [
     folder.localizedName,
   ]);
 
-  if (!Services.prompt.confirm(top, titleMsg, dialogMsg)) {
+  if (
+    !Services.prompt.confirm(
+      window.browsingContext.topChromeWindow,
+      titleMsg,
+      dialogMsg
+    )
+  ) {
     return;
   }
 
   const subscribableServer = folder.server.QueryInterface(
