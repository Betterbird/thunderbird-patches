Bug 2077919 - Resolve empty Atom link href against base URI r=mkmelin

Differential Revision: https://phabricator.services.mozilla.com/D341902


diff --git a/mailnews/extensions/newsblog/FeedParser.sys.mjs b/mailnews/extensions/newsblog/FeedParser.sys.mjs
--- a/mailnews/extensions/newsblog/FeedParser.sys.mjs
+++ b/mailnews/extensions/newsblog/FeedParser.sys.mjs
@@ -1392,17 +1392,17 @@ FeedParser.prototype = {
     // XXX Need to check for MIME type and hreflang.
     for (const alink of linkElements) {
       if (
         alink &&
         // If there's a link rel.
         ((alink.getAttribute("rel") && alink.getAttribute("rel") == linkRel) ||
           // If there isn't, assume 'alternate'.
           (!alink.getAttribute("rel") && linkRel == "alternate")) &&
-        alink.getAttribute("href")
+        alink.hasAttribute("href")
       ) {
         // Atom links are interpreted relative to xml:base.
         const href = alink.getAttribute("href");
         baseURI = alink.getAttribute("xml:base") || baseURI || href;
         try {
           return Services.io.newURI(baseURI).resolve(href);
         } catch (ex) {}
       }
diff --git a/mailnews/extensions/newsblog/test/unit/test_feedparser.js b/mailnews/extensions/newsblog/test/unit/test_feedparser.js
--- a/mailnews/extensions/newsblog/test/unit/test_feedparser.js
+++ b/mailnews/extensions/newsblog/test/unit/test_feedparser.js
@@ -605,8 +605,39 @@ add_task(function test_isValidRedirectUr
   for (const [oldUrl, newUrl, expected] of tests) {
     Assert.equal(
       parser.isValidRedirectUrl(oldUrl, newUrl),
       expected,
       `redirect from ${oldUrl} to ${newUrl} should be ${expected ? "allowed" : "rejected"}`
     );
   }
 });
+
+// Bug 2077919: An explicitly empty Atom href resolves to its xml:base,
+// while a missing href does not represent a link.
+add_task(async function test_atom_empty_href() {
+  const doc = await do_parse_document("resources/atom_dates.xml", "text/xml");
+  const parser = new FeedParser();
+  const atomNS = "http://www.w3.org/2005/Atom";
+  const base = "https://example.com/article.html";
+  const link = doc.createElementNS(atomNS, "link");
+  link.setAttribute("rel", "alternate");
+  link.setAttribute("href", "");
+  Assert.equal(
+    parser.findAtomLink("alternate", [link], base),
+    base,
+    "empty href should resolve to the entry base URI"
+  );
+
+  link.removeAttribute("href");
+  Assert.equal(
+    parser.findAtomLink("alternate", [link], base),
+    null,
+    "missing href must not be treated as an empty reference"
+  );
+
+  link.setAttribute("href", "article.html");
+  Assert.equal(
+    parser.findAtomLink("alternate", [link], "https://example.com/"),
+    base,
+    "nonempty relative links should continue to resolve normally"
+  );
+});

