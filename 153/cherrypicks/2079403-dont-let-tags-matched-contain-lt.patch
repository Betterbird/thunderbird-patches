Bug 2079403 - Don't let tags matched by FeedParser.stripTags() contain "<". r=tobyp

stripTags() matched /<[^>]+>/g, which scans to the end of the text from every
"<" that has no ">" after it, so it was quadratic on many unclosed "<". It
also removed text between a lone "<" and the next tag, e.g. "1 < 2 <i>and</i>"
became "1 and". Exclude "<" from tags.

Differential Revision: https://phabricator.services.mozilla.com/D332197

diff --git a/mailnews/extensions/newsblog/FeedParser.sys.mjs b/mailnews/extensions/newsblog/FeedParser.sys.mjs
--- a/mailnews/extensions/newsblog/FeedParser.sys.mjs
+++ b/mailnews/extensions/newsblog/FeedParser.sys.mjs
@@ -1454,9 +1454,9 @@ FeedParser.prototype = {
     return s ? s.replace(/[\x00-\x08\x0B-\x0C\x0E-\x1F\x7F]+/g, "") : "";
   },
 
   stripTags(someHTML) {
-    return someHTML ? someHTML.replace(/<[^>]+>/g, "") : someHTML;
+    return someHTML ? someHTML.replace(/<[^<>]+>/g, "") : someHTML;
   },
 
   xmlUnescape(s) {
     s = s.replace(/&lt;/g, "<");
diff --git a/mailnews/extensions/newsblog/test/unit/test_feedparser.js b/mailnews/extensions/newsblog/test/unit/test_feedparser.js
--- a/mailnews/extensions/newsblog/test/unit/test_feedparser.js
+++ b/mailnews/extensions/newsblog/test/unit/test_feedparser.js
@@ -298,4 +298,24 @@ add_task(async function test_download() 
     // Wait for this feed to complete downloading.
     await dl;
   }
 });
+
+add_task(function test_stripTags() {
+  const parser = new FeedParser();
+  Assert.equal(
+    parser.stripTags("<p>Some <b>bold</b> text</p>"),
+    "Some bold text",
+    "tags should be removed"
+  );
+  Assert.equal(
+    parser.stripTags("1 < 2 <i>and</i> 3 > 2"),
+    "1 < 2 and 3 > 2",
+    "a < that doesn't start a tag should be kept"
+  );
+  const unclosed = "<".repeat(100000);
+  Assert.equal(
+    parser.stripTags(unclosed),
+    unclosed,
+    "many unclosed < should be kept"
+  );
+});
