Bug 2076742 - Pass the password to MailAuthenticator.initNtlmAuth and catch auth module init failures. r=babolivier

initNtlmAuth called this.getPassword() without awaiting it, and
Pop3Authenticator.getPassword() is async, so POP3 NTLM passed a Promise that
ended up as the password "[object Promise]". Have callers pass the password
in, and await it for POP3.

Also call initNtlmAuth()/initGssapiAuth() inside the existing try blocks in
Pop3Client and SmtpClient, so a failing auth module or a cancelled SMTP
password prompt ends the login instead of stalling it.

Differential Revision: https://phabricator.services.mozilla.com/D329936

diff --git a/mailnews/base/src/MailAuthenticator.sys.mjs b/mailnews/base/src/MailAuthenticator.sys.mjs
--- a/mailnews/base/src/MailAuthenticator.sys.mjs
+++ b/mailnews/base/src/MailAuthenticator.sys.mjs
@@ -118,10 +118,12 @@ class MailAuthenticator {
   }
 
   /**
    * Init a nsIMailAuthModule instance for NTLM auth.
+   *
+   * @param {string} password - The server password.
    */
-  initNtlmAuth() {
+  initNtlmAuth(password) {
     this._authModule = Cc["@mozilla.org/mail/auth-module;1"].createInstance(
       Ci.nsIMailAuthModule
     );
     this._authModule.init(
@@ -129,9 +131,9 @@ class MailAuthenticator {
       null, // Service name
       0, // nsIAuthModule::REQ_DEFAULT
       null, // domain
       this.username,
-      this.getPassword()
+      password
     );
   }
 
   /**
