Bug 2089284 - Don't let a legacy feed marker in the message content switch the message pane to the Content-Base web page. r=babolivier

FeedMessageHandler.shouldShowSummary() treated an element with the id
_mailrssiframe in the displayed message as a Thunderbird 2 feed message that
can only be shown as a web page, overriding the summary preference. The
message content is controlled by the sender, so any message with the feed flag
could make the message pane load its Content-Base URL with JavaScript enabled.
Only decide based on the preferences and the feed subscription.

Differential Revision: https://phabricator.services.mozilla.com/D339841

diff --git a/mailnews/extensions/newsblog/newsblogOverlay.js b/mailnews/extensions/newsblog/newsblogOverlay.js
--- a/mailnews/extensions/newsblog/newsblogOverlay.js
+++ b/mailnews/extensions/newsblog/newsblogOverlay.js
@@ -80,24 +80,8 @@ var FeedMessageHandler = {
 
     let showSummary = true;
     this.gToggle = aToggle;
 
-    // Thunderbird 2 rss messages with 'Show article summary' not selected,
-    // ie message body constructed to show web page in an iframe, can't show
-    // a summary - notify user.
-    const browser = getMessagePaneBrowser();
-    const contentDoc = browser ? browser.contentDocument : null;
-    const rssIframe = contentDoc
-      ? contentDoc.getElementById("_mailrssiframe")
-      : null;
-    if (rssIframe) {
-      if (this.gToggle || this.onSelectPref == this.kSelectOverrideSummary) {
-        this.gToggle = false;
-      }
-
-      return false;
-    }
-
     if (aToggle) {
       // Toggle mode, flip value.
       return (this.gShowSummary = !this.gShowSummary);
     }
