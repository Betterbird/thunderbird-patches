         // Another URL has been setup to run. Process it on next loop.
         m_nextUrlReadyToRun = true;
-        m_imapMailFolderSink = nullptr;
+        SetMailFolderSink(nullptr);
       } else {
         // No more URLs setup to run. Set idle pending if user has configured
