Bug 2076569 - Fail the SMTP login when the NTLM module rejects a server challenge. r=babolivier

_actionAUTH_NTLM didn't catch an exception from getNextNtlmToken(), so a
challenge the NTLM auth module rejected left the client waiting until the
server dropped the connection. Fail the login instead, as the first NTLM step
and GSSAPI already do.

Differential Revision: https://phabricator.services.mozilla.com/D329915

diff --git a/mailnews/compose/src/SmtpClient.sys.mjs b/mailnews/compose/src/SmtpClient.sys.mjs
--- a/mailnews/compose/src/SmtpClient.sys.mjs
+++ b/mailnews/compose/src/SmtpClient.sys.mjs
@@ -820,9 +820,9 @@ export class SmtpClient {
         let token;
         try {
           token = this._authenticator.getNextNtlmToken("");
         } catch (e) {
-          this.logger.error(e);
+          this.logger.error("Getting NTLM token FAILED!", e);
           this._actionAUTHComplete({ success: false, data: "AUTH NTLM" });
           return;
         }
         this._sendCommand(`AUTH NTLM ${token}`, true);
@@ -1238,9 +1238,16 @@ export class SmtpClient {
     if (command.statusCode !== 334) {
       this._onNsError("smtpAuthFailure", command.data);
       return;
     }
-    const token = this._authenticator.getNextNtlmToken(command.data);
+    let token;
+    try {
+      token = this._authenticator.getNextNtlmToken(command.data);
+    } catch (e) {
+      this.logger.error(e);
+      this._actionAUTHComplete({ success: false, data: "AUTH NTLM" });
+      return;
+    }
     this._currentAction = this._actionAUTH_NTLM;
     this._sendCommand(token, true);
   }
 
