-        self.subtest(61, "false", ["false", "false"], "false")
-
-    def test_xulstore_false_update(self):
-        """
-        The XUL store value is false when migration happens. It should become
-        "-moz-missing\n" and the toolbars should be visible.
-        """
-        self.subtest(60, "false", [None, None], "-moz-missing\n")
-
-    def test_xulstore_true_update(self):
-        """
-        The XUL store value is true when migration happens. It should be
