Bug 1939379 - Delete an item's old property parameters when it is replaced in the storage calendar. r=tobyp

... so a stale DESCRIPTION;ALTREP no longer shadows an updated description

deleteItemById() cleared every table belonging to an item except
cal_parameters, so each modifyItem() orphaned the old rows and left them to
be re-applied the next time the item was read from disk. mDeleteParameters
was written for this but never called.

Differential Revision: https://phabricator.services.mozilla.com/D324225

diff --git a/calendar/providers/storage/CalStorageItemModel.sys.mjs b/calendar/providers/storage/CalStorageItemModel.sys.mjs
--- a/calendar/providers/storage/CalStorageItemModel.sys.mjs
+++ b/calendar/providers/storage/CalStorageItemModel.sys.mjs
@@ -1368,8 +1368,9 @@ export class CalStorageItemModel extends
   async deleteItemById(id, keepMeta) {
     const stmts = [];
     this.db.prepareItemStatement(stmts, this.statements.mDeleteAttendees, "item_id", id);
     this.db.prepareItemStatement(stmts, this.statements.mDeleteProperties, "item_id", id);
+    this.db.prepareItemStatement(stmts, this.statements.mDeleteParameters, "item_id", id);
     this.db.prepareItemStatement(stmts, this.statements.mDeleteRecurrence, "item_id", id);
     this.db.prepareItemStatement(stmts, this.statements.mDeleteEvent, "id", id);
     this.db.prepareItemStatement(stmts, this.statements.mDeleteTodo, "id", id);
     this.db.prepareItemStatement(stmts, this.statements.mDeleteAttachments, "item_id", id);
