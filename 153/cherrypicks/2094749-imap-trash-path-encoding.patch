Bug 2094749 - Encode the IMAP Trash path after UTF8=ACCEPT negotiation. r=mkmelin,nursoda

Keep the configured Trash path in UTF-8 until the connection establishes
its mailbox encoding. Use modified UTF-7 on legacy servers so discovery
recognizes an existing Trash and creates a missing one with the correct name.

Cover existing and missing non-ASCII Trash folders with the default
UTF8=ACCEPT preference.

Differential Revision: https://phabricator.services.mozilla.com/D344072

diff --git a/mailnews/imap/src/nsImapProtocol.cpp b/mailnews/imap/src/nsImapProtocol.cpp
--- a/mailnews/imap/src/nsImapProtocol.cpp
+++ b/mailnews/imap/src/nsImapProtocol.cpp
@@ -926,13 +926,9 @@ nsresult nsImapProtocol::SetupWithUrl(ns
 
     m_canonicalTrashFolderPath.Truncate();
     nsAutoCString trashFolderPath;
     if (NS_SUCCEEDED(imapServer->GetTrashFolderName(trashFolderPath))) {
-      if (m_allowUTF8Accept)
-        m_trashFolderPath = trashFolderPath;
-      else
-        CopyUTF16toMUTF7(NS_ConvertUTF8toUTF16(trashFolderPath),
-                         m_trashFolderPath);
+      m_trashFolderPathUtf8 = trashFolderPath;
     }
 
     bool preferPlainText =
         Preferences::GetBool("mailnews.display.prefer_plaintext");
@@ -2003,8 +1999,16 @@ bool nsImapProtocol::ProcessCurrentURL()
     GetTransportSecurityInfo(getter_AddRefs(m_securityInfo));
   }
 
   if (!DeathSignalReceived() && (NS_SUCCEEDED(GetConnectionStatus()))) {
+    // Use the connection's negotiated encoding before discovering mailboxes.
+    if (m_allowUTF8Accept) {
+      m_trashFolderPath = m_trashFolderPathUtf8;
+    } else {
+      CopyUTF16toMUTF7(NS_ConvertUTF8toUTF16(m_trashFolderPathUtf8),
+                       m_trashFolderPath);
+    }
+
     // if the server supports a language extension then we should
     // attempt to issue the language extension.
     if (GetServerStateParser().GetCapabilityFlag() & kHasLanguageCapability)
       Language();
diff --git a/mailnews/imap/src/nsImapProtocol.h b/mailnews/imap/src/nsImapProtocol.h
--- a/mailnews/imap/src/nsImapProtocol.h
+++ b/mailnews/imap/src/nsImapProtocol.h
@@ -392,8 +392,9 @@ class nsImapProtocol : public nsIImapPro
   nsCString m_userName;
   nsCString m_serverKey;
   char* m_dataOutputBuf;
   RefPtr<nsMsgLineStreamBuffer> m_inputStreamBuffer;
+  nsCString m_trashFolderPathUtf8;
   nsCString m_trashFolderPath;
   // Resolved lazily and reset for each URL or mailbox discovery.
   nsCString m_canonicalTrashFolderPath;
 
