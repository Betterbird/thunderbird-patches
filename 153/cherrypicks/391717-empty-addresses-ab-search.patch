Bug 391717 - Match empty senders for address book searches. r=tobyp

Differential Revision: https://phabricator.services.mozilla.com/D332677


diff --git a/mailnews/search/src/nsMsgSearchTerm.cpp b/mailnews/search/src/nsMsgSearchTerm.cpp
--- a/mailnews/search/src/nsMsgSearchTerm.cpp
+++ b/mailnews/search/src/nsMsgSearchTerm.cpp
@@ -1114,16 +1114,34 @@ NS_IMETHODIMP nsMsgSearchTerm::MatchRfc8
   // applicable to any other search type.
   if (m_operator == nsMsgSearchOp::Contains)
     return MatchRfc2047String(string, charset, false, pResult);
 
   nsTArray<nsString> names, addresses;
   ExtractAllAddresses(EncodedHeader(string, charset), names, addresses);
   uint32_t count = names.Length();
 
+  bool hasAddress = false;
+  for (const auto& address : addresses) {
+    if (!address.IsEmpty()) {
+      hasAddress = true;
+      break;
+    }
+  }
+
+  // An empty sender or recipient cannot be in the address book, but empty
+  // component headers in an AllAddresses search must not count as matches.
+  if (!hasAddress &&
+      (m_attribute == nsMsgSearchAttrib::Sender ||
+       m_attribute == nsMsgSearchAttrib::To) &&
+      m_operator == nsMsgSearchOp::IsntInAB) {
+    *pResult = true;
+    return NS_OK;
+  }
+
   nsresult rv = NS_OK;
   for (uint32_t i = 0; i < count && result == boolContinueLoop; i++) {
     if (m_operator == nsMsgSearchOp::IsInAB ||
         m_operator == nsMsgSearchOp::IsntInAB) {
       rv = MatchInAddressBook(addresses[i], &result);
     } else {
       rv = MatchString(names[i], &result);
       if (boolContinueLoop == result) rv = MatchString(addresses[i], &result);
diff --git a/mailnews/search/test/unit/test_searchAddressInAb.js b/mailnews/search/test/unit/test_searchAddressInAb.js
--- a/mailnews/search/test/unit/test_searchAddressInAb.js
+++ b/mailnews/search/test/unit/test_searchAddressInAb.js
@@ -330,11 +330,91 @@ function testAbSearch() {
       localAccountUtils.inboxFolder,
       test.value,
       test.attrib,
       test.op,
       test.count,
       testAbSearch
     );
   } else {
-    do_test_finished();
+    copyEmptyAddressMessages();
   }
 }
+
+const EmptyAddressFiles = [
+  "../../../data/bugmail9",
+  "../../../data/bugmail391717-malformed-from",
+  "../../../data/bugmail391717-missing-from",
+  "../../../data/bugmail391717-empty-to",
+  "../../../data/bugmail391717-missing-to",
+];
+
+function copyEmptyAddressMessages() {
+  const fileName = EmptyAddressFiles.shift();
+  if (!fileName) {
+    testEmptyAddresses();
+    return;
+  }
+
+  MailServices.copy.copyFileMessage(
+    do_get_file(fileName),
+    localAccountUtils.inboxFolder,
+    null,
+    false,
+    0,
+    "",
+    {
+      onStartCopy() {},
+      onProgress() {},
+      setMessageKey() {},
+      getMessageId() {
+        return null;
+      },
+      onStopCopy() {
+        copyEmptyAddressMessages();
+      },
+    },
+    null
+  );
+}
+
+function testEmptyAddresses() {
+  new TestSearch(
+    localAccountUtils.inboxFolder,
+    ABUri,
+    Sender,
+    IsntInAB,
+    8,
+    () =>
+      new TestSearch(
+        localAccountUtils.inboxFolder,
+        ABUri,
+        Sender,
+        IsInAB,
+        5,
+        () =>
+          new TestSearch(
+            localAccountUtils.inboxFolder,
+            ABUri,
+            To,
+            IsntInAB,
+            7,
+            () =>
+              new TestSearch(
+                localAccountUtils.inboxFolder,
+                ABUri,
+                To,
+                IsInAB,
+                7,
+                () =>
+                  new TestSearch(
+                    localAccountUtils.inboxFolder,
+                    ABUri,
+                    AllAddresses,
+                    IsntInAB,
+                    7,
+                    do_test_finished
+                  )
+              )
+          )
+      )
+  );
+}
