       mNumNewBiffMessages(0),
       mHaveParsedURI(false),
       mIsServerIsValid(false),
       mIsServer(false),
@@ -4957,16 +4958,50 @@ NS_IMETHODIMP nsMsgDBFolder::GetMessageH
