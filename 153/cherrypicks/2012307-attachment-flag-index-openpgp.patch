Bug 2012307 - Preserve attachment flags when indexing OpenPGP messages. r=mkmelin

Mark multipart/encrypted MIME containers as encrypted so Gloda preserves
attachment flags discovered when previewing decrypted messages.

Add regression coverage for top-level and nested encrypted content across
the local and IMAP indexing variants.

Differential Revision: https://phabricator.services.mozilla.com/D339901


diff --git a/mailnews/db/gloda/components/MimeMessageEmitter.sys.mjs b/mailnews/db/gloda/components/MimeMessageEmitter.sys.mjs
--- a/mailnews/db/gloda/components/MimeMessageEmitter.sys.mjs
+++ b/mailnews/db/gloda/components/MimeMessageEmitter.sys.mjs
@@ -132,16 +132,17 @@ MimeMessageEmitter.prototype = {
       //  content-type needs to get clobbered by the actual content-type of
       //  the enclosed message.
       this._writeBody = false;
       return;
     } else if (contentTypeNoParams.startsWith("multipart/")) {
       // this is going to fall-down with TNEF encapsulation and such, we really
       // need to just be consuming the object model.
       this._curPart = new this._mimeMsg.MimeContainer(contentTypeNoParams);
+      this._curPart.isEncrypted = contentTypeNoParams == "multipart/encrypted";
       this._writeBody = false;
     } else {
       this._curPart = new this._mimeMsg.MimeUnknown(contentTypeNoParams);
       this._writeBody = false;
     }
     // put the full content-type in the headers and normalize out any newlines
     this._curPart.headers["content-type"] = [
       aContentType.replace(deathToNewlines, ""),
