Bug 2083579 - Restrict favicon fetches to remote URLs. r=tobyp

Differential Revision: https://phabricator.services.mozilla.com/D335049

diff --git a/mailnews/extensions/newsblog/FeedUtils.sys.mjs b/mailnews/extensions/newsblog/FeedUtils.sys.mjs
--- a/mailnews/extensions/newsblog/FeedUtils.sys.mjs
+++ b/mailnews/extensions/newsblog/FeedUtils.sys.mjs
@@ -948,8 +948,11 @@ export var FeedUtils = {
      * @param {string} faviconUrl - The favicon url.
      * @returns {Blob} - Existing favicon.
      */
     const fetchFavicon = async faviconUrl => {
+      if (!["http:", "https:"].includes(URL.parse(faviconUrl)?.protocol)) {
+        throw new Error(`Not fetching favicon from url ${faviconUrl}`);
+      }
       const response = await fetch(faviconUrl);
       if (!response.ok) {
         throw new Error(`No favicon for url ${faviconUrl}`);
       }
@@ -965,8 +968,11 @@ export var FeedUtils = {
      * @param {string} page - The page url to check.
      * @returns {Blob} - Found favicon.
      */
     const discoverFaviconURL = async page => {
+      if (!["http:", "https:"].includes(URL.parse(page)?.protocol)) {
+        throw new Error(`Not fetching favicon from url ${page}`);
+      }
       const response = await fetch(page);
       if (!response.ok) {
         throw new Error(`No favicon for page ${page}`);
       }
diff --git a/mailnews/extensions/newsblog/test/unit/test_getFavicon.js b/mailnews/extensions/newsblog/test/unit/test_getFavicon.js
--- a/mailnews/extensions/newsblog/test/unit/test_getFavicon.js
+++ b/mailnews/extensions/newsblog/test/unit/test_getFavicon.js
@@ -35,4 +35,41 @@ add_task(async function test_relative_fa
     favicon.startsWith("data:image/svg+xml"),
     "relative favicon URL should resolve against the nested page URL"
   );
 });
+
+add_task(async function test_no_file_favicon() {
+  const iconPath = PathUtils.join(PathUtils.profileDir, "icon.svg");
+  await IOUtils.writeUTF8(
+    iconPath,
+    '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"></svg>'
+  );
+  const iconURL = PathUtils.toFileURI(iconPath);
+  httpServer.registerPathHandler(
+    "/file-icon/page.html",
+    (request, response) => {
+      response.setHeader("Content-Type", "text/html");
+      response.write(
+        `<!doctype html><html><head><link rel="icon" href="${iconURL}"></head></html>`
+      );
+    }
+  );
+
+  Assert.equal(
+    await FeedUtils.getFavicon(
+      null,
+      `http://localhost:${SERVER_PORT}/file-icon/page.html`
+    ),
+    "",
+    "a file: favicon url from a web page should not be fetched"
+  );
+  const pagePath = PathUtils.join(PathUtils.profileDir, "page.html");
+  await IOUtils.writeUTF8(
+    pagePath,
+    '<!doctype html><html><head><link rel="icon" href="icon.svg"></head></html>'
+  );
+  Assert.equal(
+    await FeedUtils.getFavicon(null, PathUtils.toFileURI(pagePath)),
+    "",
+    "a favicon should not be fetched for a file: url"
+  );
+});
