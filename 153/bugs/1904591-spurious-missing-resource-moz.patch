+    /// Whether a complete bundle has been generated for the current locale.
+    /// This is used to suppress missing resource errors when a higher-priority
+    /// metasource (such as a language pack) already provided all resources,
+    /// and only a lower-priority metasource is lacking them.
+    generated_bundle: bool,
 }
 
 impl<P, B> GenerateBundles<P, B> {
     fn new(
@@ -127,8 +132,9 @@ impl<P, B> GenerateBundles<P, B> {
             locales,
             current_metasource: 0,
             resource_ids,
             state: State::Empty,
+            generated_bundle: false,
         }
     }
 }
 
