Bug 2061534 - Fix fallout from bug 2052415 which turned NNTP .dat files into folders.

diff --git a/mailnews/base/src/nsMsgDBFolder.cpp b/mailnews/base/src/nsMsgDBFolder.cpp
--- a/mailnews/base/src/nsMsgDBFolder.cpp
+++ b/mailnews/base/src/nsMsgDBFolder.cpp
@@ -4921,8 +4921,21 @@ NS_IMETHODIMP nsMsgDBFolder::GetMessageH
 NS_IMETHODIMP nsMsgDBFolder::GetDescendants(
     nsTArray<RefPtr<nsIMsgFolder>>& aDescendants) {
   aDescendants.Clear();
 
+  // NNTP and RSS servers store non-folder data files (.dat, .json etc.) in
+  // their directory alongside folders. DiscoverChildFolders would
+  // misinterpret these as subfolders. Skip discovery for these server types.
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  nsAutoCString type;
+  if (NS_SUCCEEDED(GetServer(getter_AddRefs(server))) && server) {
+    server->GetType(type);
+  }
+  if (type.LowerCaseEqualsLiteral("nntp") ||
+      type.LowerCaseEqualsLiteral("rss")) {
+    mDiscoveredSubFolders = true;
+  }
+
   // `mSubFolders` only holds folders that have already been discovered into
   // memory. At startup the subfolders of accounts other than the one shown in
   // the folder pane have not been discovered yet, so callers that walk the
   // descendants (for example the unread-count badge) would miss them. Ask the
