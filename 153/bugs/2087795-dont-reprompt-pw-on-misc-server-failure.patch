# HG changeset patch
# User Betterbird <betterbird@betterbird.eu> and DeepSeek
# Date 1794067485 -7200
# Parent  98984d16d06947273998b9167850f5820f127375
Bug 2087795 - Don't reprompt for password if server misbehaves for other reasons (like maintenance). POP, SMTP and IMAP covered, see below.

According to DeepSeek the issue for CalDAV and the ICS provider was already fixed in bug 1991785 and bug 2083485, both cherry-picked:
https://hg.mozilla.org/comm-central/rev/8fb75afa0d9e
https://hg.mozilla.org/comm-central/rev/461b5eefc858
https://hg.mozilla.org/comm-central/rev/b7a219737c33

We've added a similar hunk for CardDAV (CardDAVUtils.sys.mjs).

diff --git a/mailnews/addrbook/modules/CardDAVUtils.sys.mjs b/mailnews/addrbook/modules/CardDAVUtils.sys.mjs
--- a/mailnews/addrbook/modules/CardDAVUtils.sys.mjs
+++ b/mailnews/addrbook/modules/CardDAVUtils.sys.mjs
@@ -603,8 +603,16 @@ export class NotificationCallbacks {
     "nsIAuthPrompt2",
     "nsIChannelEventSink",
   ]);
   promptAuth(channel, level, authInfo) {
+    if (authInfo.flags & Ci.nsIAuthInformation.AUTH_PROXY) {
+      // The channel URI is the server, not the proxy, so everything below
+      // would pick the server's credentials.
+      // FIXME: Proxies that ask for Basic or Digest credentials can't be used
+      // for address books. NTLM and Negotiate proxies are answered by necko
+      // with the system credentials and never get here.
+      return false;
+    }
     if (authInfo.flags & Ci.nsIAuthInformation.PREVIOUS_FAILED) {
       return false;
     }
 
