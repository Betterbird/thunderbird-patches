# Parent  71589c79b7156889f0b24c144c1e235ef595cdb5
NNN83 - Recompute the tolerance buffer size when resetting the tree view.

The tolerance buffer size is calculated from ThreadRow.ROW_HEIGHT, which
changes when the density or font size changes. Recalculate it in
TreeView.reset() so the buffer doesn't grow unboundedly (every row in the
folder) when no resize event follows, for example with the message pane
hidden on Wayland.

diff --git a/mail/base/content/widgets/tree-view.mjs b/mail/base/content/widgets/tree-view.mjs
--- a/mail/base/content/widgets/tree-view.mjs
+++ b/mail/base/content/widgets/tree-view.mjs
@@ -520,8 +520,10 @@ export class BaseTreeView extends HTMLEl
   /**
    * Clear all rows from the list and create them again.
    */
   reset() {
+    // ROW_HEIGHT may have changed since the tolerance buffer was calculated.
+    this.#calculateToleranceBufferSize();
     this.#resetRowBuffer();
     this.#ensureVisibleRowsAreDisplayed();
   }
 
