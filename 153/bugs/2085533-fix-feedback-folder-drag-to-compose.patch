Bug 2085533 - Fix feedback when dragging OS folder to compose window.

Follow-up to bug 1930447.

diff --git a/mail/components/compose/content/MsgComposeCommands.js b/mail/components/compose/content/MsgComposeCommands.js
--- a/mail/components/compose/content/MsgComposeCommands.js
+++ b/mail/components/compose/content/MsgComposeCommands.js
@@ -11183,8 +11183,13 @@ var envelopeDragObserver = {
               (!event.dataTransfer.files.length ||
                 this.isNotDraggingOnlyImages(event.dataTransfer) ||
                 !gMsgCompose.composeHTML)
           );
+      } else if (
+        event.dataTransfer.mozTypesAt(0).contains("application/x-moz-file")
+      ) {
+        // Refuse OS folders: they can't be attached.
+        event.dataTransfer.dropEffect = "none";
       }
     }
 
     this.detectHoveredOverlay(event.target.id);
