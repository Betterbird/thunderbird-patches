# HG changeset patch
# User Betterbird <betterbird@betterbird.eu>
# Date 1794857767 -7200
# Parent  75770d404bb29d6fe3b8fa3db873660ad3cf0a11
NNN39 - Persist new sort order in cache even if MSF write fails. Log error to console.

diff --git a/mailnews/base/src/nsMsgDBFolder.cpp b/mailnews/base/src/nsMsgDBFolder.cpp
--- a/mailnews/base/src/nsMsgDBFolder.cpp
+++ b/mailnews/base/src/nsMsgDBFolder.cpp
@@ -5217,15 +5217,26 @@ nsresult nsMsgDBFolder::CloseDB() {
 }
 
 NS_IMETHODIMP nsMsgDBFolder::SetUserSortOrder(uint32_t order) {
   if (order != mUserSortOrder) {
+    // Always set the order, so the cache gets updated, even of the access
+    // to the DB fails.
+    mUserSortOrder = order;
     nsCOMPtr<nsIMsgDatabase> db;
     nsCOMPtr<nsIDBFolderInfo> folderInfo;
     nsresult rv =
         GetDBFolderInfoAndDB(getter_AddRefs(folderInfo), getter_AddRefs(db));
     if (NS_SUCCEEDED(rv)) {
-      folderInfo->SetUserSortOrder(mUserSortOrder = order);
+      folderInfo->SetUserSortOrder(order);
       if (db) db->Commit(nsMsgDBCommitType::kLargeCommit);
+    } else {
+      nsCString uri;
+      GetURI(uri);
+      nsCString msg = nsPrintfCString(
+          "Failed to set new sort order for folder %s. Repair the folder!",
+          uri.get());
+      MsgLogToConsole4(NS_ConvertUTF8toUTF16(msg), nsCString(__FILE__),
+                       __LINE__, nsIScriptError::errorFlag);
     }
   }
   return NS_OK;
 }
