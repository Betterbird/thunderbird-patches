Bug 2082672 - Focus newly created feed account in 3pane to give access to Account Central, Manage Subscriptions, etc.

diff --git a/mail/base/content/messenger.js b/mail/base/content/messenger.js
--- a/mail/base/content/messenger.js
+++ b/mail/base/content/messenger.js
@@ -290,8 +290,27 @@ var gMailInit = {
    *
    * @param {Event} event - The message event.
    */
   _onMessageReceived(event) {
+    if (event.data?.type == "feed-account-created") {
+      // The feed account wizard asked the main window to display the root
+      // folder of the newly created feed account.
+      const tabmail = document.getElementById("tabmail");
+      if (!tabmail.currentAbout3Pane) {
+        tabmail.switchToTab(0);
+        tabmail.updateCurrentTab();
+      }
+      const about3Pane = tabmail.currentAbout3Pane;
+      if (about3Pane) {
+        const row = about3Pane.folderPane.getRowForFolder(
+          event.data.rootFolderURI
+        );
+        about3Pane.displayFolder(event.data.rootFolderURI);
+        about3Pane.paneLayout.folderPaneSplitter.isCollapsed = false;
+        window.focus();
+      }
+    }
+
     switch (event.data) {
       case "account-created":
       case "account-created-in-backend":
         // Set the pref to false in case it was previously changed.
