-    SetCharAttribute(prefName, (*retval)->URI());
+  nsCOMPtr<nsIMsgFolder> newFolder;
+  rv = rootFolder->GetChildNamed(folderName, getter_AddRefs(newFolder));
+  if (!newFolder) {
+    // Account for protocol-specific URI details, notably IMAP personal
+    // namespaces.
+    nsAutoCString serverURI;
+    rv = server->GetServerURI(serverURI);
+    if (NS_SUCCEEDED(rv)) {
+      serverURI.Append('/');
+      serverURI.Append(folderName);
+      nsCOMPtr<nsIMsgFolder> mappedFolder;
+      rv = server->GetMsgFolderFromURI(nullptr, serverURI,
+                                       getter_AddRefs(mappedFolder));
+      if (NS_SUCCEEDED(rv) && mappedFolder) {
+        nsAutoCString mappedURI;
+        mappedFolder->GetURI(mappedURI);
+        rv = rootFolder->GetChildWithURI(mappedURI, true, true,
+                                         getter_AddRefs(newFolder));
+      }
+    }
+  }
+  if (NS_SUCCEEDED(rv) && newFolder) {
+    newFolder->SetFlag(folderFlag);
+    SetCharAttribute(prefName, newFolder->URI());
+    SetCharAttribute(pickerModePrefName, "1"_ns);
+    newFolder.forget(retval);
     return true;
   }
   return false;
 }
 
