+static nsresult FindServerForFolderURI(nsIMsgAccountManager* accountManager,
+                                       const nsACString& folderURI,
+                                       nsIMsgIncomingServer** server) {
+  NS_ENSURE_ARG_POINTER(server);
+  *server = nullptr;
+
+  nsCOMPtr<nsIURL> url;
+  nsresult rv = NS_MutateURI(NS_STANDARDURLMUTATOR_CONTRACTID)
+                    .SetSpec(folderURI)
+                    .Finalize(url);
+  NS_ENSURE_SUCCESS(rv, rv);
+
+  if (url->SchemeIs("mailbox")) {
+    // Local folders can be backed by several server types, all of which use
+    // mailbox URIs for their folders.
+    if (NS_SUCCEEDED(NS_MutateURI(url).SetScheme("none"_ns).Finalize(url))) {
+      accountManager->FindServerByURI(url, server);
+    }
+    if (!*server &&
+        NS_SUCCEEDED(NS_MutateURI(url).SetScheme("pop3"_ns).Finalize(url))) {
+      accountManager->FindServerByURI(url, server);
+    }
+    if (!*server &&
+        NS_SUCCEEDED(NS_MutateURI(url).SetScheme("rss"_ns).Finalize(url))) {
+      accountManager->FindServerByURI(url, server);
+    }
+  } else {
+    accountManager->FindServerByURI(url, server);
+  }
+
+  return NS_OK;
+}
+
+bool nsMsgIdentity::useAccountDefaultFolder(const char* pickerModePrefName) {
+  nsAutoCString pickerMode;
+  mPrefBranch->GetStringPref(pickerModePrefName, EmptyCString(), 1, pickerMode);
+  // Missing legacy values have always been displayed as account-default.
+  return !pickerMode.EqualsLiteral("1");
+}
+
+nsresult nsMsgIdentity::getExistingSpecialFolder(
+    const char* prefName, const char* pickerModePrefName, uint32_t folderFlag,
+    nsIMsgFolder** existingFolder, nsIMsgIncomingServer** configuredServer) {
+  NS_ENSURE_ARG_POINTER(existingFolder);
+  *existingFolder = nullptr;
+  if (configuredServer) {
+    *configuredServer = nullptr;
+  }
+
+  nsAutoCString prefValue;
+  mPrefBranch->GetStringPref(prefName, EmptyCString(), 1, prefValue);
+  if (prefValue.IsEmpty()) {
+    return NS_OK;
+  }
+
+  nsCOMPtr<nsIMsgAccountManager> accountManager =
+      mozilla::components::AccountManager::Service();
+  nsCOMPtr<nsIMsgIncomingServer> server;
+  FindServerForFolderURI(accountManager, prefValue, getter_AddRefs(server));
+  if (configuredServer && server) {
+    NS_ADDREF(*configuredServer = server);
+  }
+
+  // Only accept folders that are actually in the configured server's tree.
+  // The folder lookup service can also contain detached placeholders for
+  // folders which do not exist yet.
+  nsCOMPtr<nsIMsgFolder> rootFolder;
+  if (server &&
+      NS_SUCCEEDED(server->GetRootMsgFolder(getter_AddRefs(rootFolder))) &&
+      rootFolder) {
+    nsAutoCString rootURI;
+    rootFolder->GetURI(rootURI);
+    if (rootURI.Equals(prefValue)) {
+      rootFolder.forget(existingFolder);
+      return NS_OK;
+    }
+
+    nsCOMPtr<nsIMsgFolder> folder;
+    rootFolder->GetChildWithURI(prefValue, true, true, getter_AddRefs(folder));
+    if (folder) {
+      folder.forget(existingFolder);
+      return NS_OK;
+    }
+  }
+
+  // An explicit "Other" selection is authoritative. If it has disappeared,
+  // do not silently substitute a folder selected by flags or another server.
+  if (!useAccountDefaultFolder(pickerModePrefName) || !server || !rootFolder) {
+    return NS_OK;
+  }
+
+  // Let the configured server account for protocol-specific URI details,
+  // notably IMAP personal namespaces. Pass no detached fallback folder: a
+  // result is only useful if it can then be found in the live folder tree.
+  nsCOMPtr<nsIMsgFolder> mappedFolder;
+  server->GetMsgFolderFromURI(nullptr, prefValue, getter_AddRefs(mappedFolder));
+  if (mappedFolder) {
+    nsAutoCString mappedURI;
+    mappedFolder->GetURI(mappedURI);
+    nsCOMPtr<nsIMsgFolder> treeFolder;
+    rootFolder->GetChildWithURI(mappedURI, true, true,
+                                getter_AddRefs(treeFolder));
+    if (treeFolder) {
+      nsresult rv = setFolderPref(prefName, mappedURI, folderFlag);
+      NS_ENSURE_SUCCESS(rv, rv);
+      // The concrete folder was resolved on the configured server; switch
+      // the picker to the explicit folder mode, like the special folder
+      // checks do after IMAP discovery.
+      SetCharAttribute(pickerModePrefName, "1"_ns);
+      treeFolder.forget(existingFolder);
+      return NS_OK;
+    }
+  }
+
+  // In account-default mode a server-designated folder is also a valid
+  // resolution, but only on the server selected by the preference.
+  nsCOMPtr<nsIMsgFolder> flaggedFolder;
+  rootFolder->GetFolderWithFlags(folderFlag, getter_AddRefs(flaggedFolder));
+  if (flaggedFolder) {
+    nsAutoCString flaggedURI;
+    flaggedFolder->GetURI(flaggedURI);
+    nsresult rv = setFolderPref(prefName, flaggedURI, folderFlag);
+    NS_ENSURE_SUCCESS(rv, rv);
+    SetCharAttribute(pickerModePrefName, "1"_ns);
+    flaggedFolder.forget(existingFolder);
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP nsMsgIdentity::GetExistingTemplatesFolder(
