 let smartMailboxInstance = null;
+let mfnListenerRegistered = false;
+
+function isDisplayedIn3Pane(folder) {
+  for (const win of Services.wm.getEnumerator("mail:3pane")) {
+    const tabmail = win.document.getElementById("tabmail");
+    for (const tab of tabmail?.tabInfo ?? []) {
+      if (tab.mode?.name != "mail3PaneTab") {
+        continue;
+      }
+      const about3Pane = tab.chromeBrowser?.contentWindow;
+      if (about3Pane?.gViewWrapper?.displayedFolder?.URI == folder.URI) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+function adjustTagFolderCount(folder, delta, aMsg) {
+  try {
+    const msgDatabase = folder.msgDatabase;
+    const folderInfo = msgDatabase.dBFolderInfo;
+    folderInfo.numMessages = Math.max(0, folderInfo.numMessages + delta);
+    if (!aMsg.isRead) {
+      folderInfo.numUnreadMessages = Math.max(
+        0,
+        folderInfo.numUnreadMessages + delta
+      );
+    }
+    msgDatabase.commit(Ci.nsMsgDBCommitType.kLargeCommit);
+    folder.updateSummaryTotals(true);
+    // Keep the cached search results of the folder the message lives in up to
+    // date, see nsMsgDatabase::UpdateHdrInCache(). -- !! Betterbird only !!
+    aMsg.folder.msgDatabase.updateHdrInCache(folder.URI, aMsg, delta == 1);
+  } catch (ex) {
+    console.error(`Failed to update tag folder counts for ${folder.URI}`, ex);
+  }
+}
+
+/**
+ * Update the counts of the tag folders when keywords change, since a message
+ * may now match, or no longer match, the search of a tag folder. Folders
+ * displayed in a 3-pane window are skipped: the counts of those are updated
+ * by the view itself, see nsMsgXFVirtualFolderDBView::OnHdrPropertyChanged().
+ */
+const tagFolderListener = {
+  msgPropertyChanged(aMsg, aProperty, aOldValue, aNewValue) {
+    if (aProperty != "keywords" || !smartMailboxInstance) {
+      return;
+    }
+    // The tag folders search all folders except the unwanted types listed.
+    if (
+      aMsg.folder.isSpecialFolder(
+        Ci.nsMsgFolderFlags.Trash |
+          Ci.nsMsgFolderFlags.Junk |
+          Ci.nsMsgFolderFlags.Queue |
+          Ci.nsMsgFolderFlags.Virtual,
+        true
+      )
+    ) {
+      return;
+    }
+
+    const oldKeys = new Set(aOldValue.split(" ").filter(Boolean));
+    const newKeys = new Set(aNewValue.split(" ").filter(Boolean));
+    const changedKeys = new Set();
+    for (const key of oldKeys) {
+      if (!newKeys.has(key)) {
+        changedKeys.add(key);
+      }
+    }
+    for (const key of newKeys) {
+      if (!oldKeys.has(key)) {
+        changedKeys.add(key);
+      }
+    }
+
+    for (const key of changedKeys) {
+      if (!lazy.MailServices.tags.isValidKey(key)) {
+        continue;
+      }
+      const tag = lazy.MailServices.tags.getAllTags().find(t => t.key == key);
+      const folder = smartMailboxInstance.getTagFolder(tag);
+      if (!folder || isDisplayedIn3Pane(folder)) {
+        continue;
+      }
+      adjustTagFolderCount(folder, newKeys.has(key) ? 1 : -1, aMsg);
+    }
+  },
+};
 
