Bug 1901846 - suppress status feedback after announcing compaction result.

diff --git a/mail/base/content/mailWindow.js b/mail/base/content/mailWindow.js
--- a/mail/base/content/mailWindow.js
+++ b/mail/base/content/mailWindow.js
@@ -400,8 +400,13 @@ nsMsgStatusFeedback.prototype = {
   _statusFeedbackProgress: -1,
   _statusLastShown: 0,
   _lastStatusText: null,
   _timeoutDelay: ChromeUtils.isInAutomation ? 50 : 500,
+  _suppress: false,
+
+  setSuppress(suppress) {
+    this._suppress = suppress;
+  },
 
   // unload - call to remove links to listeners etc.
   unload() {
     // Remove listeners for any active processes we have hooked ourselves into.
@@ -490,8 +495,11 @@ nsMsgStatusFeedback.prototype = {
    * @param {string} statusText - The status string to display.
    * @see {nsIMsgStatusFeedback}
    */
   showStatusString(statusText) {
+    if (this._suppress) {
+      return;
+    }
     if (this._clearTimeoutID) {
       // Cancel clear regardless:
       // If we get a new status, we don't want to clear it with a stale timer.
       // If we get an empty status, clearing is done already.
@@ -1217,8 +1225,9 @@ window.addEventListener("aboutMessageLoa
 const messengerBundle = Services.strings.createBundle(
   "chrome://messenger/locale/messenger.properties"
 );
 contentProgress.addListener({
+  feedbackSuppressed: false,
   onLocationChange() {
     // Clear any URL for a hovered link that is displayed in the status bar.
     window.MsgStatusFeedback.setOverLink("");
   },
@@ -1246,13 +1255,21 @@ contentProgress.addListener({
 
     if (browser.id == "messagepane") {
       if (stateFlags & Ci.nsIWebProgressListener.STATE_IS_NETWORK) {
         if (stateFlags & Ci.nsIWebProgressListener.STATE_START) {
+          if (window.MsgStatusFeedback._suppress) {
+            this.feedbackSuppressed = true;
+            return;
+          }
           window.MsgStatusFeedback.startMeteors();
           window.MsgStatusFeedback.showStatusString(
             messengerBundle.GetStringFromName("documentLoading")
           );
         } else if (stateFlags & Ci.nsIWebProgressListener.STATE_STOP) {
+          if (this.feedbackSuppressed) {
+            this.feedbackSuppressed = false;
+            return;
+          }
           window.MsgStatusFeedback.stopMeteors();
           // stopMeteors() already resets the status string, but with a delay.
           // We do it immediately so we don't see "Loading message..." for longer
           // than necessary.
diff --git a/mail/modules/DBViewWrapper.sys.mjs b/mail/modules/DBViewWrapper.sys.mjs
--- a/mail/modules/DBViewWrapper.sys.mjs
+++ b/mail/modules/DBViewWrapper.sys.mjs
@@ -1449,9 +1449,13 @@ DBViewWrapper.prototype = {
     if (aFolder != this.displayedFolder) {
       return;
     }
 
+    // Hack to not overwrite the status feedback holding the compaction result.
+    const mainWindow = Services.wm.getMostRecentWindow("mail:3pane");
+    mainWindow.MsgStatusFeedback.setSuppress(true);
     this.refresh();
+    mainWindow.MsgStatusFeedback.setSuppress(false);
   },
 
   /**
    * DB Views need help to know when their move / deletion operations complete.
