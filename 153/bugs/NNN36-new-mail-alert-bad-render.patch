NNN36 - Make new mail alert window invisible until it's needed.

diff --git a/mailnews/base/content/newmailalert.js b/mailnews/base/content/newmailalert.js
--- a/mailnews/base/content/newmailalert.js
+++ b/mailnews/base/content/newmailalert.js
@@ -145,8 +145,10 @@ async function doOnAlertLoad() {
   // the window may use a default OS-determined size that doesn't match the
   // content at the current DPI, causing text to be cut off or the window
   // to be too large.
   window.sizeToContent();
+  // Make it visible when the content is there. Hopefully avoids showing empty windows.
+  window.docShell.treeOwner.QueryInterface(Ci.nsIBaseWindow).visibility = true;
 
   // Pre-snap the window immediately to prevent the OS from flashing its
   // native shell in the top-left corner. We capture the initial dimensions
   // only after this move, ensuring our baseline accounts for any OS-level
diff --git a/mailnews/base/src/MailNotificationManager.sys.mjs b/mailnews/base/src/MailNotificationManager.sys.mjs
--- a/mailnews/base/src/MailNotificationManager.sys.mjs
+++ b/mailnews/base/src/MailNotificationManager.sys.mjs
@@ -618,8 +618,10 @@ export const MailNotificationManager = n
             win.devicePixelRatio
         );
       }
     }
+    // Make the window invisible since it may not be rendered correctly.
+    win.docShell.treeOwner.QueryInterface(Ci.nsIBaseWindow).visibility = false;
 
     this._customizedAlertShown = true;
     this._saveNotificationTime(folder, newMsgKeys);
   }
