Bug 2068501 - Fix Retry and save to local folder after copy to FCC failed.

diff --git a/mailnews/compose/src/MessageSend.sys.mjs b/mailnews/compose/src/MessageSend.sys.mjs
--- a/mailnews/compose/src/MessageSend.sys.mjs
+++ b/mailnews/compose/src/MessageSend.sys.mjs
@@ -30,8 +30,17 @@ export class MessageSend {
     "nsISupportsWeakReference",
   ]);
   classID = Components.ID("{028b9c1e-8d0a-4518-80c2-842e07846eaa}");
 
+  // A failed copy into a local folder is reported twice: through
+  // notifyListenerOnStopCopy, called by the copy service listener while
+  // startCopyOperation is still running, and through the error thrown by
+  // startCopyOperation. _startCopyInProgress marks the synchronous copy call,
+  // and _copyFailureReported that the failure was already reported while it
+  // ran, so it is not handled a second time.
+  _startCopyInProgress = false;
+  _copyFailureReported = false;
+
   /**
    * Create an rfc822 message and send it.
 
    * @param {nsIEditor} editor - nsIEditor instance that contains message.
@@ -408,8 +417,14 @@ export class MessageSend {
   async notifyListenerOnStopCopy(status) {
     lazy.MsgUtils.sendLogger.debug(
       `notifyListenerOnStopCopy; status=${status}`
     );
+    // A failure reported while startCopyOperation is still running will also
+    // be thrown by it once the call returns, so the catch in _mimeDoFcc can
+    // see that the failure was already handled here.
+    if (!Components.isSuccessCode(status) && this._startCopyInProgress) {
+      this._copyFailureReported = true;
+    }
     this._msgCopy = null;
 
     if (!this._isRetry) {
       const statusMsgEntry = Components.isSuccessCode(status)
@@ -1055,8 +1070,13 @@ export class MessageSend {
       [folder?.localizedName || "?"]
     );
     this._setStatusMessage(statusMsg);
     lazy.MsgUtils.sendLogger.debug("startCopyOperation");
+    // Set just before the call, after _createCopyFile. A retry started from
+    // the failure dialog suspends in _createCopyFile, so it can't clear the
+    // record of the failure currently being handled.
+    this._copyFailureReported = false;
+    this._startCopyInProgress = true;
     try {
       this._msgCopy.startCopyOperation(
         this._userIdentity,
         this._copyFile,
@@ -1065,15 +1085,23 @@ export class MessageSend {
         this._folderUri,
         this._msgToReplace
       );
     } catch (e) {
-      lazy.MsgUtils.sendLogger.warn(
-        `startCopyOperation failed with ${e.result}`
-      );
+      const status = e.result ?? Cr.NS_ERROR_FAILURE;
+      lazy.MsgUtils.sendLogger.warn(`startCopyOperation failed with ${status}`);
       if (throwOnError) {
-        throw Components.Exception("startCopyOperation failed", e.result);
+        throw Components.Exception("startCopyOperation failed", status);
       }
-      await this.notifyListenerOnStopCopy(e.result);
+      // For a local folder the copy runs synchronously, so the failure has
+      // already been reported through notifyListenerOnStopCopy, which showed
+      // the retry/save dialog and may have started a new copy attempt from
+      // it. Don't handle the failure a second time.
+      if (this._copyFailureReported) {
+        return;
+      }
+      await this.notifyListenerOnStopCopy(status);
+    } finally {
+      this._startCopyInProgress = false;
     }
   }
 
