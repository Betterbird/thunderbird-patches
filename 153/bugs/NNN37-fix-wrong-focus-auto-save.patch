NNN37 - Fix annoying wrong focus when auto-save follows manual save.

diff --git a/mail/components/compose/content/MsgComposeCommands.js b/mail/components/compose/content/MsgComposeCommands.js
--- a/mail/components/compose/content/MsgComposeCommands.js
+++ b/mail/components/compose/content/MsgComposeCommands.js
@@ -3369,8 +3369,17 @@ function ToggleWindowLock(aDisable) {
   if (!aDisable) {
     updateComposeItems();
     // Refocus what had focus when the lock began.
     ToggleWindowLock.activeElement?.focus();
+    // Clear the stored element so a later unlock that isn't preceded by a
+    // matching lock can't refocus it. This happens during auto-save: it never
+    // calls ToggleWindowLock(true), but ComposeProcessDone() still calls
+    // ToggleWindowLock(false) when the save finishes. If we kept the stale
+    // element from an earlier lock (e.g. a manual save), auto-save would yank
+    // focus back to it, e.g. moving the caret from the subject into the body
+    // or from the body into the subject, restoring the focus of the earlier
+    // manual save.
+    ToggleWindowLock.activeElement = null;
   }
 }
 
 /* This function will go away soon as now arguments are passed to the window using a object of type nsMsgComposeParams instead of a string */
