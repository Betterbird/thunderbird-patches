 /**
+ * Wrapper around an async statement that logs the statement's SQL when its
+ *  async execution reports an error, so the failure can be attributed to the
+ *  statement that caused it.
+ */
+function SQLTrackingStatementWrapper(aRealStatement, aSQLString) {
+  this.real = aRealStatement;
+  this.sqlString = aSQLString;
+}
+SQLTrackingStatementWrapper.prototype = {
+  bindByIndex(aColIndex, aValue) {
+    this.real.bindByIndex(aColIndex, aValue);
+  },
+  executeAsync(aCallback) {
+    const sqlString = this.sqlString;
+    return this.real.executeAsync({
+      handleResult(aResultSet) {
+        if (aCallback.handleResult) {
+          aCallback.handleResult(aResultSet);
+        }
+      },
+      handleError(aError) {
+        GlodaDatastore._log.error(
+          "async statement failed: " +
+            aError.result +
+            ": " +
+            aError.message +
+            " - " +
+            sqlString
+        );
+        if (aCallback.handleError) {
+          aCallback.handleError(aError);
+        }
+      },
+      handleCompletion(aReason) {
+        if (aCallback.handleCompletion) {
+          aCallback.handleCompletion(aReason);
+        }
+      },
+    });
+  },
+  finalize() {
+    this.real.finalize();
+  },
+};
+
+/**
  * Writes a single JSON document to the provide file path in a streaming
  *  fashion.  At startup we open an array to place the queries in and at
  *  shutdown we close it.
  */
