Backout bug 1873959, take 2: We always need to build buildid.h, but make sure that application.ini and AppConstants.sys.mjs get the same BuildID.

diff --git a/Makefile.in b/Makefile.in
--- a/Makefile.in
+++ b/Makefile.in
@@ -15,11 +15,28 @@ endif
 
 include $(topsrcdir)/config/config.mk
 
 ifneq (mobile/android,$(MOZ_BUILD_APP))
-# Always build buildid.h.
+# Always build buildid.h during the export tier, so that every build gets a
+# fresh buildid that all consumers (the binaries, application.ini and
+# preprocessed JS modules) pick up. The misc tier also runs export as a
+# prerequisite (see root-deps.mk), but those nested make invocations have
+# recurse_export in MAKECMDGOALS rather than export, so buildid.h is only
+# regenerated once per build, before the binaries are compiled. Packaging
+# goals never match, so packaging keeps the buildid too.
+#
+# The export:: rule pulls buildid.h and source-repo.h into the export tier's
+# dependency graph, otherwise the FORCE rule below would never be evaluated:
+# make only rebuilds targets that the goals depend on. FORCE then marks the
+# stubs as always out of date, so the stub recipes in backend.mk regenerate
+# the headers. Via buildid.h (compiled into the binaries as application.ini.h)
+# and the buildid.h includes in application.ini and preprocessed JS modules,
+# one fresh buildid per build reaches all consumers.
+ifneq ($(filter export,$(MAKECMDGOALS)),)
+export:: buildid.h source-repo.h
 $(MDDEPDIR)/buildid.h.stub $(MDDEPDIR)/source-repo.h.stub: FORCE
 endif
+endif
 source-repo.h: $(MDDEPDIR)/source-repo.h.stub
 buildid.h: $(MDDEPDIR)/buildid.h.stub
 
 BUILD_BACKEND_FILES := $(addprefix backend.,$(addsuffix Backend,$(BUILD_BACKENDS)))
