# HG changeset patch
# User Betterbird <betterbird@betterbird.eu> and DeepSeek
# Date 1788638277 -7200
# Parent  2c5a3790a4f9ad03237d775eea929e3f3bdb62be
Feature: Introduce pref betterbird.window.restorePositionX11 to restore window position on X11.

diff --git a/modules/libpref/init/all.js b/modules/libpref/init/all.js
--- a/modules/libpref/init/all.js
+++ b/modules/libpref/init/all.js
@@ -4118,8 +4118,12 @@ pref("captchadetection.actor.enabled", t
 // Make general.smoothScroll sticky to avoid being clobbered by
 // preferes-reduced-motion system setting.
 pref("general.smoothScroll", true, sticky);
 
+// Betterbird: Restore the saved window position on X11 instead of leaving
+// window placement to the window manager.
+pref("betterbird.window.restorePositionX11", false);
+
 // Trigger FOG's Artifact Build support on artifact builds.
 #ifdef MOZ_ARTIFACT_BUILDS
   pref("telemetry.fog.artifact_build", true);
 #endif
diff --git a/xpfe/appshell/AppWindow.cpp b/xpfe/appshell/AppWindow.cpp
--- a/xpfe/appshell/AppWindow.cpp
+++ b/xpfe/appshell/AppWindow.cpp
@@ -82,8 +82,12 @@
 #  include "mozilla/widget/NativeMenuSupport.h"
 #  define USE_NATIVE_MENUS
 #endif
 
+#ifdef MOZ_WIDGET_GTK
+#  include "mozilla/WidgetUtilsGtk.h"
+#endif
+
 #define SIZEMODE_NORMAL u"normal"_ns
 #define SIZEMODE_MAXIMIZED u"maximized"_ns
 #define SIZEMODE_MINIMIZED u"minimized"_ns
 #define SIZEMODE_FULLSCREEN u"fullscreen"_ns
@@ -2507,9 +2511,20 @@ void AppWindow::SizeShell() {
 #if defined(XP_UNIX) && !defined(XP_MACOSX)
   // don't override WM placement on unix for independent, top-level windows
   // (however, we think the benefits of intelligent dependent window placement
   // trump that override.)
-  if (!parentWindow) positionSet = false;
+  if (!parentWindow) {
+    positionSet = false;
+#  ifdef MOZ_WIDGET_GTK
+    // On X11, gtk_window_move() sets the USPosition hint so the window manager
+    // honours the saved position. On Wayland the compositor decides placement
+    // and client-side positioning is ignored, so don't try there.
+    if (mozilla::widget::GdkIsX11Display() &&
+        Preferences::GetBool("betterbird.window.restorePositionX11", false)) {
+      positionSet = true;
+    }
+#  endif
+  }
 #endif
   if (positionSet) {
     // We have to do this before sizing the window, because sizing depends
     // on the resolution of the screen we're on. But positioning needs to
