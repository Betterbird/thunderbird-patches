# HG changeset patch
# User Betterbird <betterbird@betterbird.eu> and DeepSeek
# Date 1788854238 -7200
# Parent  c325b424a0f6e6fc721333782b439b02fc07f204
Feature: Restore window position on X11.

This patch follows the implementation in https://bugzilla.mozilla.org/show_bug.cgi?id=2070008

diff --git a/widget/gtk/nsWindow.cpp b/widget/gtk/nsWindow.cpp
--- a/widget/gtk/nsWindow.cpp
+++ b/widget/gtk/nsWindow.cpp
@@ -1105,10 +1105,13 @@ void nsWindow::Move(const DesktopPoint& 
   // the parent, the parent might have moved so we always move a
   // popup window.
   auto pos = GetScreenBoundsUnscaled().TopLeft();
   LOG("  bounds %d x %d\n", int(pos.x), int(pos.y));
+  // Before the window is shown, still issue the move even if the position
+  // is unchanged, so gtk_window_move() sets the USPosition hint and the
+  // window manager honours the requested position.
   if (pos == request && mLastMoveRequest == request &&
-      mWindowType != WindowType::Popup) {
+      mWindowType != WindowType::Popup && mIsShown) {
     LOG("  position is the same, return\n");
     return;
   }
 
@@ -1452,8 +1455,16 @@ nsresult nsWindow::GetRestoredBounds(Lay
   // decorations yet when we get to restore it. This matches previous behavior,
   // though it's a bit unfortunate.
   aRect = GetScreenBounds();
   aRect.SizeTo(GetClientSize());
+  if (ToplevelUsesCSD()) {
+    // gtk_window_move() on CSD windows takes the position of the visible
+    // window, excluding the shadow margin drawn inside the outer X window.
+    // GetScreenBounds() returns the outer X window origin, so persist the
+    // client area origin instead, or the window drifts by the shadow margin
+    // on every restore.
+    aRect.MoveTo(GetClientBounds().TopLeft());
+  }
   LOG("nsWindow::GetRestoredBounds() %s", ToString(aRect).c_str());
   return NS_OK;
 }
 
@@ -4767,17 +4778,15 @@ void nsWindow::NativeMoveResize(bool aMo
   // Window size is calculated without decorations, Gtk adds decorations
   // size to our request at gtk_window_resize().
   GdkRectangle moveResizeRect = [&] {
     auto cr = frameRect;
-    // In CSD mode gtk_window_move() / gtk_window_resize() expects coordinates
-    // without CSD frame so remove it.
-    // Note that popups should have zero margin.
+    // gtk_window_resize() expects the client size without decorations
+    // (the CSD shadow margin, or the WM frame in SSD mode), so remove
+    // the margins from the size. Note that popups should have zero margin.
     cr.Deflate(mClientMargin);
-    // SSD mode expects coordinates with decorations (outer frame)
-    // so put the margin offset back.
-    if (!ToplevelUsesCSD()) {
-      cr -= DesktopIntPoint(mClientMargin.left, mClientMargin.top);
-    }
+    // The deflate also shifts the position, but gtk_window_move() takes
+    // the window position as-is (see GetRestoredBounds), so undo that.
+    cr -= DesktopIntPoint(mClientMargin.left, mClientMargin.top);
     return GdkRectangle{cr.x, cr.y, cr.width, cr.height};
   }();
 
   LOG("nsWindow::NativeMoveResize mLastMoveRequest [%d,%d] mClientMargin "
diff --git a/xpfe/appshell/AppWindow.cpp b/xpfe/appshell/AppWindow.cpp
--- a/xpfe/appshell/AppWindow.cpp
+++ b/xpfe/appshell/AppWindow.cpp
@@ -1209,9 +1209,12 @@ bool AppWindow::LoadPositionFromXUL(int3
                       cssSize.height);
     }
   }
   mWindow->ConstrainPosition(specPoint);
-  if (specPoint != curPoint) {
+  if (gotPosition) {
+    // Apply the saved position even if it equals the current one: the widget
