@@ -1452,8 +1455,16 @@ nsresult nsWindow::GetRestoredBounds(Lay
   // decorations yet when we get to restore it. This matches previous behavior,
   // though it's a bit unfortunate.
   aRect = GetScreenBounds();
   aRect.SizeTo(GetClientSize());
+  if (ToplevelUsesCSD()) {
+    // gtk_window_move() on CSD windows takes the position of the visible
+    // window, excluding the shadow margin drawn inside the outer X window.
+    // GetScreenBounds() returns the outer X window origin, so persist the
+    // client area origin instead, or the window drifts by the shadow margin
+    // on every restore.
+    aRect.MoveTo(GetClientBounds().TopLeft());
+  }
   LOG("nsWindow::GetRestoredBounds() %s", ToString(aRect).c_str());
   return NS_OK;
 }
 
