+// Adds the dbusmenu properties of the item at nIndex in pModel to cProps.
+static void menuAddItemProps (GVariantBuilder *cProps, GMenuModel *pModel, gint nIndex, gboolean bHasChildren)
+{
+    gchar *sLabel = NULL;
+    g_menu_model_get_item_attribute (pModel, nIndex, G_MENU_ATTRIBUTE_LABEL, "s", &sLabel);
+
+    if (!sLabel)
+    {
+        sLabel = g_strdup ("");
+    }
+
+    g_variant_builder_add (cProps, "{sv}", "label", g_variant_new_string (sLabel));
+    g_variant_builder_add (cProps, "{sv}", "enabled", g_variant_new_boolean (TRUE));
+    g_variant_builder_add (cProps, "{sv}", "visible", g_variant_new_boolean (TRUE));
+    g_variant_builder_add (cProps, "{sv}", "type", g_variant_new_string ("standard"));
+
+    if (bHasChildren)
+    {
+        g_variant_builder_add (cProps, "{sv}", "children-display", g_variant_new_string ("submenu"));
+    }
+
+    g_free (sLabel);
+}
