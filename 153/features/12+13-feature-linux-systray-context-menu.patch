+static void quitBetterbird() {
+  // Check if it's okay to quit.
+  nsCOMPtr<nsISupportsPRBool> cancelQuit =
+      do_CreateInstance(NS_SUPPORTS_PRBOOL_CONTRACTID);
+  cancelQuit->SetData(false);
+
+  nsCOMPtr<nsIObserverService> obs = mozilla::services::GetObserverService();
+  obs->NotifyObservers(cancelQuit, "quit-application-requested", nullptr);
+
+  bool shouldCancelQuit;
+  cancelQuit->GetData(&shouldCancelQuit);
+
+  if (!shouldCancelQuit) {
+    // Perform quit.
+    nsCOMPtr<nsIAppStartup> appStartup = components::AppStartup::Service();
+    if (!appStartup) {
+      return;
+    }
+    bool userAllowedQuit = true;
+    appStartup->Quit(nsIAppStartup::eAttemptQuit, 0, &userAllowedQuit);
+  }
+}
+
+static void quitActionActivated(GSimpleAction* aAction, GVariant* aParameter,
+                                gpointer aData) {
+  quitBetterbird();
+}
+
+static void trayEnsureQuitLabel() {
+  if (!sQuitLabel.IsEmpty()) {
+    return;
+  }
+  // Localize the exit item label.
+  RefPtr<mozilla::intl::Localization> l10n =
+      mozilla::intl::Localization::Create(
+          {"branding/brand.ftl"_ns, "messenger/menubar.ftl"_ns}, true);
+  nsresult rv = LocalizeMessage(l10n, "system-tray-menuitem-quit"_ns, {},
+                                sQuitLabel);
+  if (NS_FAILED(rv)) {
+    sQuitLabel.AssignLiteral("Quit Betterbird");
+  }
+}
+
+static void trayCreateMenu() {
+  trayEnsureQuitLabel();
+
+  GMenu* menu = g_menu_new();
+  g_menu_append(menu, sQuitLabel.get(), "quit");
+
+  GSimpleActionGroup* actions = g_simple_action_group_new();
+  GSimpleAction* quitAction = g_simple_action_new("quit", NULL);
+  g_signal_connect(quitAction, "activate", G_CALLBACK(quitActionActivated),
+                   NULL);
+  g_action_map_add_action(G_ACTION_MAP(actions), G_ACTION(quitAction));
+  g_object_unref(quitAction);
+
+  app_indicator_set_menu(ci, menu);
+  app_indicator_set_actions(ci, actions);
+  g_object_unref(menu);
+  g_object_unref(actions);
+}
+
+static void trayMenuItemQuitActivated(GtkMenuItem* aItem, gpointer aData) {
+  quitBetterbird();
+}
+
+static void trayCreateGtkMenu() {
+  trayEnsureQuitLabel();
+
+  GtkWidget* menu = gtk_menu_new();
+  GtkWidget* item = gtk_menu_item_new_with_label(sQuitLabel.get());
+  g_signal_connect(G_OBJECT(item), "activate",
+                   G_CALLBACK(trayMenuItemQuitActivated), NULL);
+  gtk_menu_shell_append(GTK_MENU_SHELL(menu), item);
+  gtk_widget_show(item);
+  trayMenu = GTK_MENU(menu);
+}
