+// Betterbird: libayatana-appindicator-glib exports its menu exclusively via
+// org.gtk.Menus, but the StatusNotifierItem hosts used in practice (KDE
+// Plasma, the Xfce SNI plugin and the GNOME Shell AppIndicator extension)
+// only implement the legacy com.canonical.dbusmenu protocol.  When they learn
+// the Menu object path from the SNI "Menu" property, they talk dbusmenu to it.
+// So serve the menu over com.canonical.dbusmenu as well, on the same object
+// path, mirroring the GMenu set via app_indicator_set_menu().
+static const gchar *sDbusMenuXML =
+"<node>"
+"  <interface name=\"com.canonical.dbusmenu\">"
+"    <property name=\"Version\" type=\"u\" access=\"read\" />"
+"    <property name=\"TextDirection\" type=\"s\" access=\"read\" />"
+"    <property name=\"Status\" type=\"s\" access=\"read\" />"
+"    <property name=\"IconThemePath\" type=\"as\" access=\"read\" />"
+"    <method name=\"GetLayout\">"
+"      <arg type=\"i\" name=\"parentId\" direction=\"in\" />"
+"      <arg type=\"i\" name=\"recursionDepth\" direction=\"in\" />"
+"      <arg type=\"as\" name=\"propertyNames\" direction=\"in\" />"
+"      <arg type=\"u\" name=\"revision\" direction=\"out\" />"
+"      <arg type=\"(ia{sv}av)\" name=\"layout\" direction=\"out\" />"
+"    </method>"
+"    <method name=\"GetGroupProperties\">"
+"      <arg type=\"ai\" name=\"ids\" direction=\"in\" />"
+"      <arg type=\"as\" name=\"propertyNames\" direction=\"in\" />"
+"      <arg type=\"a(ia{sv})\" name=\"properties\" direction=\"out\" />"
+"    </method>"
+"    <method name=\"GetProperty\">"
+"      <arg type=\"i\" name=\"id\" direction=\"in\" />"
+"      <arg type=\"s\" name=\"name\" direction=\"in\" />"
+"      <arg type=\"v\" name=\"value\" direction=\"out\" />"
+"    </method>"
+"    <method name=\"Event\">"
+"      <arg type=\"i\" name=\"id\" direction=\"in\" />"
+"      <arg type=\"s\" name=\"eventId\" direction=\"in\" />"
+"      <arg type=\"v\" name=\"data\" direction=\"in\" />"
+"      <arg type=\"u\" name=\"timestamp\" direction=\"in\" />"
+"    </method>"
+"    <method name=\"EventGroup\">"
+"      <arg type=\"a(isvu)\" name=\"events\" direction=\"in\" />"
+"      <arg type=\"ai\" name=\"idErrors\" direction=\"out\" />"
+"    </method>"
+"    <method name=\"AboutToShow\">"
+"      <arg type=\"i\" name=\"id\" direction=\"in\" />"
+"      <arg type=\"b\" name=\"needUpdate\" direction=\"out\" />"
+"    </method>"
+"    <method name=\"AboutToShowGroup\">"
+"      <arg type=\"ai\" name=\"ids\" direction=\"in\" />"
+"      <arg type=\"ai\" name=\"updatesNeeded\" direction=\"out\" />"
+"      <arg type=\"ai\" name=\"idErrors\" direction=\"out\" />"
+"    </method>"
+"  </interface>"
+"</node>";
+
+// Adds the dbusmenu properties of the item at nIndex in pModel to cProps.
+static void menuAddItemProps (GVariantBuilder *cProps, GMenuModel *pModel, gint nIndex, gboolean bHasChildren)
+{
+    gchar *sLabel = NULL;
+    g_menu_model_get_item_attribute (pModel, nIndex, G_MENU_ATTRIBUTE_LABEL, "s", &sLabel);
+
+    if (!sLabel)
+    {
+        sLabel = g_strdup ("");
+    }
+
+    g_variant_builder_add (cProps, "{sv}", "label", g_variant_new_string (sLabel));
+    g_variant_builder_add (cProps, "{sv}", "enabled", g_variant_new_boolean (TRUE));
+    g_variant_builder_add (cProps, "{sv}", "visible", g_variant_new_boolean (TRUE));
+    g_variant_builder_add (cProps, "{sv}", "type", g_variant_new_string ("standard"));
+
+    if (bHasChildren)
+    {
+        g_variant_builder_add (cProps, "{sv}", "children-display", g_variant_new_string ("submenu"));
+    }
+
+    g_free (sLabel);
+}
+
+// Walks the menu model with the same numbering as menuBuildLayout() and
+// returns the model and index of the item with the id nTarget.
+static gboolean menuFindItem (GMenuModel *pModel, gint nTarget, gint *pNextId, GMenuModel **ppModel, gint *pnIndex)
+{
+    gint nItems = g_menu_model_get_n_items (pModel);
+
+    for (gint i = 0; i < nItems; i++)
+    {
+        (*pNextId)++;
+
+        if (*pNextId == nTarget)
+        {
+            *ppModel = pModel;
+            *pnIndex = i;
+
+            return TRUE;
+        }
+
+        GMenuModel *pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SECTION);
+
+        if (!pSection)
+        {
+            pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SUBMENU);
+        }
+
+        if (pSection)
+        {
+            gboolean bFound = menuFindItem (pSection, nTarget, pNextId, ppModel, pnIndex);
+            g_object_unref (pSection);
+
+            if (bFound)
+            {
+                return TRUE;
+            }
+        }
+    }
+
+    return FALSE;
+}
+
+// Builds the dbusmenu layout of the items of the model pModel into cChildren,
+// assigning ids from *pNextId in preorder, starting with 1 (0 is the root).
+static void menuBuildLayout (GVariantBuilder *cChildren, GMenuModel *pModel, gint *pNextId)
+{
+    gint nItems = g_menu_model_get_n_items (pModel);
+
+    for (gint i = 0; i < nItems; i++)
+    {
+        gint nId = ++(*pNextId);
+
+        GMenuModel *pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SECTION);
+
+        if (!pSection)
+        {
+            pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SUBMENU);
+        }
+
+        gboolean bHasChildren = pSection && g_menu_model_get_n_items (pSection) > 0;
+
+        GVariantBuilder cProps;
+        g_variant_builder_init (&cProps, G_VARIANT_TYPE ("a{sv}"));
+        menuAddItemProps (&cProps, pModel, i, bHasChildren);
+
+        GVariantBuilder cChildItems;
+        g_variant_builder_init (&cChildItems, G_VARIANT_TYPE ("av"));
+
+        if (bHasChildren)
+        {
+            menuBuildLayout (&cChildItems, pSection, pNextId);
+        }
+
+        g_variant_builder_add (cChildren, "v", g_variant_new ("(ia{sv}av)", nId, &cProps, &cChildItems));
+
+        if (pSection)
+        {
+            g_object_unref (pSection);
+        }
+    }
+}
+
+// Finds the node with the id nId in the layout children array pChildren (an
+// 'av' array whose elements are variants wrapping the nodes) and returns a new
+// reference to the unwrapped node, or NULL if there is no such node.
+static GVariant* menuFindNode (GVariant *pChildren, gint nId)
+{
+    gsize nCount = g_variant_n_children (pChildren);
+
+    for (gsize i = 0; i < nCount; i++)
+    {
+        GVariant *pWrapped = g_variant_get_child_value (pChildren, i);
+        GVariant *pNode = g_variant_get_variant (pWrapped);
+        g_variant_unref (pWrapped);
+        gint nNodeId = 0;
+        g_variant_get_child (pNode, 0, "i", &nNodeId);
+
+        if (nNodeId == nId)
+        {
+            return pNode;
+        }
+
+        GVariant *pGrandChildren = g_variant_get_child_value (pNode, 2);
+        GVariant *pFound = menuFindNode (pGrandChildren, nId);
+        g_variant_unref (pGrandChildren);
+        g_variant_unref (pNode);
+
+        if (pFound)
+        {
+            return pFound;
+        }
+    }
+
+    return NULL;
+}
+
+// Finds the menu item with the id nTarget (using the same numbering as
+// menuBuildLayout()) and returns its action name and target.  Returns FALSE if
+// there is no such item.
+static gboolean menuFindAction (GMenuModel *pModel, gint nTarget, gint *pNextId, gchar **ppAction, GVariant **ppTarget)
+{
+    gint nItems = g_menu_model_get_n_items (pModel);
+
+    for (gint i = 0; i < nItems; i++)
+    {
+        (*pNextId)++;
+
+        if (*pNextId == nTarget)
+        {
+            gchar *sAction = NULL;
+            g_menu_model_get_item_attribute (pModel, i, G_MENU_ATTRIBUTE_ACTION, "s", &sAction);
+            *ppAction = sAction;
+            *ppTarget = g_menu_model_get_item_attribute_value (pModel, i, G_MENU_ATTRIBUTE_TARGET, NULL);
+
+            return TRUE;
+        }
+
+        GMenuModel *pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SECTION);
+
+        if (!pSection)
+        {
+            pSection = g_menu_model_get_item_link (pModel, i, G_MENU_LINK_SUBMENU);
+        }
+
+        if (pSection)
+        {
+            gboolean bFound = menuFindAction (pSection, nTarget, pNextId, ppAction, ppTarget);
+            g_object_unref (pSection);
+
+            if (bFound)
+            {
+                return TRUE;
+            }
+        }
+    }
+
+    return FALSE;
+}
+
+// Activates the action of the menu item with the id nId, mirroring a
+// "clicked" event.  Returns TRUE if the event was handled.
+static gboolean menuActivateItem (AppIndicatorPrivate *pPrivate, gint nId)
+{
+    if (!pPrivate->pMenu || !pPrivate->pActions)
+    {
+        return FALSE;
+    }
+
+    gint nNextId = 0;
+    gchar *sAction = NULL;
+    GVariant *pTarget = NULL;
+    gboolean bHandled = FALSE;
+
+    if (menuFindAction (G_MENU_MODEL (pPrivate->pMenu), nId, &nNextId, &sAction, &pTarget) && sAction)
+    {
+        GAction *pAction = g_action_map_lookup_action (G_ACTION_MAP (pPrivate->pActions), sAction);
+
+        if (pAction)
+        {
+            g_action_activate (pAction, pTarget);
+            bHandled = TRUE;
+        }
+    }
+
+    g_free (sAction);
+
+    if (pTarget)
+    {
+        g_variant_unref (pTarget);
+    }
+
+    return bHandled;
+}
+
+// Serves the com.canonical.dbusmenu methods for the indicator's context menu.
+static void onMenuMethodCall (GDBusConnection *pConnection, const gchar *sSender, const gchar *sPath, const gchar *sInterface, const gchar *sMethod, GVariant *pParams, GDBusMethodInvocation *pInvocation, gpointer pData)
+{
+    g_return_if_fail (APP_IS_INDICATOR (pData));
+
+    AppIndicator *self = APP_INDICATOR (pData);
+    AppIndicatorPrivate *pPrivate = app_indicator_get_instance_private (self);
+
+    if (g_strcmp0 (sMethod, "GetLayout") == 0)
+    {
+        gint nParentId = 0;
+        gint nRecursionDepth = -1;
+        const gchar* const* sPropertyNames = NULL;
+        g_variant_get (pParams, "(ii^as)", &nParentId, &nRecursionDepth, &sPropertyNames);
+
+        GVariantBuilder cChildren;
+        g_variant_builder_init (&cChildren, G_VARIANT_TYPE ("av"));
+        gint nNextId = 0;
+
+        if (pPrivate->pMenu)
+        {
+            menuBuildLayout (&cChildren, G_MENU_MODEL (pPrivate->pMenu), &nNextId);
+        }
+
+        if (nParentId == 0)
+        {
+            GVariantBuilder cRootProps;
+            g_variant_builder_init (&cRootProps, G_VARIANT_TYPE ("a{sv}"));
+            g_dbus_method_invocation_return_value (pInvocation, g_variant_new ("(u(ia{sv}av))", (guint32) 1, (gint) 0, &cRootProps, &cChildren));
+
+            return;
+        }
+
+        GVariant *pChildrenArray = g_variant_builder_end (&cChildren);
+        GVariant *pNode = menuFindNode (pChildrenArray, nParentId);
+        g_variant_unref (pChildrenArray);
+
+        if (pNode)
+        {
+            g_dbus_method_invocation_return_value (pInvocation, g_variant_new ("(u@(ia{sv}av))", (guint32) 1, pNode));
+            g_variant_unref (pNode);
+        }
+        else
+        {
+            g_dbus_method_invocation_return_error (pInvocation, G_DBUS_ERROR, G_DBUS_ERROR_INVALID_ARGS, "No such menu item: %d", nParentId);
+        }
+
+        return;
+    }
+
+    if (g_strcmp0 (sMethod, "Event") == 0)
+    {
+        gint nId = 0;
+        const gchar *sEventId = NULL;
+        GVariant *pData = NULL;
+        guint nTimestamp = 0;
+        g_variant_get (pParams, "(i&svu)", &nId, &sEventId, &pData, &nTimestamp);
+
+        if (g_strcmp0 (sEventId, "clicked") == 0)
+        {
+            menuActivateItem (pPrivate, nId);
+        }
+
+        g_variant_unref (pData);
+        g_dbus_method_invocation_return_value (pInvocation, NULL);
+
+        return;
+    }
+
+    if (g_strcmp0 (sMethod, "EventGroup") == 0)
+    {
+        GVariantBuilder cIdErrors;
+        g_variant_builder_init (&cIdErrors, G_VARIANT_TYPE ("ai"));
+
+        GVariant *pEvents = g_variant_get_child_value (pParams, 0);
+        gsize nEvents = g_variant_n_children (pEvents);
+
+        for (gsize i = 0; i < nEvents; i++)
+        {
+            GVariant *pEvent = g_variant_get_child_value (pEvents, i);
+            gint nId = 0;
+            const gchar *sEventId = NULL;
+            GVariant *pData = NULL;
+            guint nTimestamp = 0;
+            g_variant_get (pEvent, "(i&svu)", &nId, &sEventId, &pData, &nTimestamp);
+
+            gboolean bHandled = FALSE;
+
+            if (g_strcmp0 (sEventId, "clicked") == 0)
+            {
+                bHandled = menuActivateItem (pPrivate, nId);
+            }
+
+            if (!bHandled)
+            {
+                g_variant_builder_add (&cIdErrors, "i", nId);
+            }
+
+            g_variant_unref (pData);
+            g_variant_unref (pEvent);
+        }
+
+        g_variant_unref (pEvents);
+
+        g_dbus_method_invocation_return_value (pInvocation, g_variant_new ("(ai)", &cIdErrors));
+
+        return;
+    }
+
+    if (g_strcmp0 (sMethod, "GetGroupProperties") == 0)
+    {
+        GVariantBuilder cProperties;
+        g_variant_builder_init (&cProperties, G_VARIANT_TYPE ("a(ia{sv})"));
+
+        GVariant *pIds = g_variant_get_child_value (pParams, 0);
+        GVariant *pNames = g_variant_get_child_value (pParams, 1);
+        gsize nIds = g_variant_n_children (pIds);
+
+        for (gsize i = 0; i < nIds; i++)
+        {
+            gint nId = 0;
+            g_variant_get_child (pIds, i, "i", &nId);
+
+            if (nId == 0 && pPrivate->pMenu)
+            {
+                // The root only exposes how its children are displayed.
+                GVariantBuilder cProps;
+                g_variant_builder_init (&cProps, G_VARIANT_TYPE ("a{sv}"));
+
+                if (g_menu_model_get_n_items (G_MENU_MODEL (pPrivate->pMenu)) > 0)
+                {
+                    g_variant_builder_add (&cProps, "{sv}", "children-display", g_variant_new_string ("submenu"));
+                }
+
+                g_variant_builder_add (&cProperties, "(ia{sv})", (gint) 0, &cProps);
+
+                continue;
+            }
+
+            GMenuModel *pModel = NULL;
+            gint nIndex = -1;
+            gint nNextId = 0;
+
+            if (!pPrivate->pMenu ||
