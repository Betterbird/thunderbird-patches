@@ -511,6 +542,14 @@
 #endif
     }
   }
+  // gtk_window_is_maximized() only knows about the state reported by the
+  // window manager. If the window is hidden before it has ever been mapped
+  // (as happens when starting minimized to the tray on Wayland), GTK still
+  // considers it unmaximized. Consult the XUL window's sizemode attribute
+  // which AppWindow has already restored from the XUL store in that case.
+  if (!dims.maximized) {
+    dims.maximized = windowSizemodeIsMaximized(aWindow);
+  }
   aWindow->SetVisibility(false);
   sHiddenWindows.AppendElement(aWindow);
   sHiddenWindowsDims.AppendElement(dims);
