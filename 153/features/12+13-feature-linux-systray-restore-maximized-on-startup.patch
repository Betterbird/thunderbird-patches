 }
 
+static bool windowSizemodeIsMaximized(nsIBaseWindow* aWindow) {
+  nsCOMPtr<nsIAppWindow> appWindow = do_QueryInterface(aWindow);
+  if (!appWindow) {
+    return false;
+  }
+  nsCOMPtr<nsIDocShell> docShell;
+  appWindow->GetDocShell(getter_AddRefs(docShell));
+  if (!docShell) {
+    return false;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> domWindow = docShell->GetWindow();
+  if (!domWindow) {
+    return false;
+  }
+  RefPtr<dom::Document> doc = domWindow->GetDocument();
+  if (!doc) {
+    return false;
+  }
+  RefPtr<dom::Element> root = doc->GetDocumentElement();
+  if (!root) {
+    return false;
+  }
+  nsAutoString sizemode;
+  root->GetAttr(nsGkAtoms::sizemode, sizemode);
+  return sizemode.EqualsLiteral("maximized");
+}
