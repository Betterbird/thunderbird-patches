+      this.log.debug("onclose: closed - " + headerEditorDialog.returnValue);
+    };
+    headerEditorDialog.addEventListener("close", onClose);
+
+    return headerEditorDialog;
+  }
+
+  async updateHeadersWithDialog() {
+    await this.#getMessageDeferred.promise;
+
+    this.log.groupCollapsed(
+      `updateHeadersWithDialog: ${this.origMsgHdr.subject}`
+    );
+    this.#headerEditorDialog = this.#initHeaderEditorDialog();
+    if (this.#headerEditorDialog) {
+      this.#headerEditorDialog.showModal();
+    } else {
+      this.#onError("updateHeadersWithDialog: failed to initialize dialog");
+    }
+
+    this.log.groupEnd(`updateHeadersWithDialog: ${this.origMsgHdr.subject}`);
+  }
+
+  async #onSuccess(newMsgKey, args) {
+    this.log.debug("#onSuccess: newMsgKey - " + newMsgKey);
+    this.log.debug(
+      "#onSuccess: origMsgHdr messageKey:flags:keywords - " +
+        this.origMsgHdr.messageKey +
+        ":" +
+        this.origMsgHdrFlags +
+        ":" +
+        this.origMsgHdrKeywords
+    );
+
+    if (newMsgKey === false) {
+      // Case of no change.
+      try {
+        this.#successFn(false, this.log);
+      } catch (exception) {
+        this.log.error("#onError: successFn exception - " + exception);
+      }
+      return;
+    }
+
+    let newMsgHdr;
+    try {
+      newMsgHdr = this.origMsgHdr.folder.GetMessageHeader(newMsgKey);
+
+      this.log.debug(
+        "#onSuccess: newMsgHdr  messageKey:flags:keywords - " +
+          newMsgHdr.messageKey +
+          ":" +
+          newMsgHdr.flags +
+          ":" +
+          newMsgHdr.getStringProperty("keywords")
+      );
+    } catch (ex) {
+      this.#onError(
+        `#onSuccess: could not get msgHdr from messageKey: ${newMsgKey} - ` + ex
+      );
+      return;
+    }
+
+    // For imap, copyFileMessage() is a fail for tags, so add them now.
+    if (
+      this.origMsgHdrKeywords &&
+      this.origMsgHdr.folder.flags & Ci.nsMsgFolderFlags.ImapBox
+    ) {
+      this.log.debug(
+        "#onSuccess: restore IMAP tags - " + this.origMsgHdrKeywords
+      );
+      // Remove possible stale X-Mozilla-Keys.
+      this.origMsgHdr.folder.removeKeywordsFromMessages(
+        [newMsgHdr],
+        newMsgHdr.getStringProperty("keywords")
+      );
+      this.origMsgHdr.folder.addKeywordsToMessages(
+        [newMsgHdr],
+        this.origMsgHdrKeywords
+      );
+    }
+    // For imap, copyFileMessage() is a fail for flags, so add them now.
+    if (this.origMsgHdr.folder.flags & Ci.nsMsgFolderFlags.ImapBox) {
+      newMsgHdr.orFlags(this.origMsgHdrFlags);
+      this.log.debug("#onSuccess: restore IMAP flags - " + newMsgHdr.flags);
+    }
+
+    this.#newMessageURI = newMsgHdr.folder.getUriForMsg(newMsgHdr);
+    const oldMessageURI = this.#messageURI;
+
+    this.log.debug("#onSuccess: oldMessageURI - " + oldMessageURI);
+    this.log.debug("#onSuccess: newMessageURI - " + this.#newMessageURI);
+
+    if (this.#replace) {
+      await this.#deleteMessages(args);
+    }
+
+    try {
+      this.#successFn(newMsgHdr, this.log);
+    } catch (exception) {
+      this.log.error("#onError: successFn exception - " + exception);
+    }
+
+    // And update all other places with the new or added message.
+    Services.obs.notifyObservers(
+      {
+        oldMessageURI: this.#replace ? oldMessageURI : this.#newMessageURI,
+        newMessageURI: this.#newMessageURI,
+        log: this.log,
+      },
+      "message-replaced"
+    );
+  }
+
+  #onError(error) {
+    this.log.error("#onError: error - " + (error ?? "logged to console"));
+    try {
+      this.#errorFn(error, this.log);
+    } catch (exception) {
+      this.log.error("#onError: errorFn exception - " + exception);
+    }
+  }
+}
