+
+  async #removeTmpFile(file) {
+    try {
+      await IOUtils.remove(file.path);
+    } catch (ex) {
+      // Don't throw here, a quiet message is enough.
+    }
+    if (file.exists()) {
+      this.log.debug(
+        "#removeTmpFile: failed; remove on shutdown - " + file.path
+      );
+      const extAppLauncher = Cc[
+        "@mozilla.org/uriloader/external-helper-app-service;1"
+      ].getService(Ci.nsPIExternalAppLauncher);
+      extAppLauncher.deleteTemporaryFileOnExit(file);
+    }
+  }
+
+  async #updateFolder(folder) {
+    const log = this.log;
+    if (!(folder instanceof Ci.nsIMsgImapMailFolder)) {
+      return;
+    }
+    const { promise, resolve } = Promise.withResolvers();
+    /**  @implements {nsIUrlListener} */
+    const urlListener = {
+      OnStartRunningUrl() {},
+      OnStopRunningUrl(url, statusCode) {
+        if (!Components.isSuccessCode(statusCode)) {
+          log.warn("#updateFolder: error - " + statusCode);
+        }
+        resolve();
