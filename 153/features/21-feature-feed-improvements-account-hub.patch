diff --git a/mail/components/accountcreation/views/feed.mjs b/mail/components/accountcreation/views/feed.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/accountcreation/views/feed.mjs
@@ -0,0 +1,241 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import "chrome://messenger/content/accountcreation/content/widgets/account-hub-step.mjs"; // eslint-disable-line import/no-unassigned-import
+import "chrome://messenger/content/accountcreation/content/widgets/account-hub-footer.mjs"; // eslint-disable-line import/no-unassigned-import
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  FeedUtils: "resource:///modules/FeedUtils.sys.mjs",
+});
+
+class AccountHubFeed extends HTMLElement {
+  /**
+   * Dialog.
+   *
+   * @type {HTMLElement}
+   */
+  #dialog;
+
+  /**
+   * String of ID of current step; there is only one: "feedAccountView".
+   *
+   * @type {string}
+   */
+  #currentState;
+
+  /**
+   * Feed account footer.
+   *
+   * @type {HTMLElement}
+   */
+  #footer;
+
+  /**
+   * States of the feed account setup flow, based on the ID's of the steps in
+   * the flow. We only have one state, no back/forward.
+   *
+   * @type {object}
+   */
+  #states = {
+    feedAccountView: {
+      id: "feedAccountForm",
+      nextStep: true,
+      previousStep: "",
+      forwardEnabled: true,
+      customForwardFluentID: "account-hub-email-finish-button",
+      validityValueMissingFluentID: "account-hub-address-book-name-error-text",
+      validityAlreadyExistsFluentID: "category-overwrite-title",
+      defaultAccountNameFluentID: "account-settings-rss-default-account-name",
+      subview: {},
+      templateId: "feed-account-form",
+    },
+  };
+
+  async connectedCallback() {
+    if (this.hasConnected) {
+      return;
+    }
+
+    this.hasConnected = true;
+
+    this.classList.add("account-hub-view");
+
+    const template = document.getElementById("accountHubFeedSetup");
+    this.appendChild(template.content.cloneNode(true));
+
+    for (const state of Object.values(this.#states)) {
+      state.subview = this.querySelector(`#${state.id}`);
+    }
+
+    const container = document.querySelector("account-hub-container");
+    this.#dialog = container.shadowRoot.querySelector(".account-hub-dialog");
+
+    this.#footer = this.querySelector("#feedAccountFooter");
+    this.#footer.addEventListener("forward", this);
+    this.addEventListener("submit", this);
+    this.addEventListener("config-updated", this);
+    this.ready = this.#initUI("feedAccountView");
+    await this.ready;
+  }
+
+  /**
+   * Returns the subview of the current state.
+   *
+   * @returns {HTMLElement} The current subview.
+   */
+  get #currentSubview() {
+    return this.#states[this.#currentState].subview;
+  }
+
+  /**
+   * Handle the events from the subviews.
+   *
+   * @param {Event} event
+   */
+  async handleEvent(event) {
+    switch (event.type) {
+      case "submit":
+        event.preventDefault();
+      // Fall through to handle like forward event.
+      case "forward":
+        if (this.checkValidity()) {
+          this.onFinish();
+        }
+        break;
+      case "config-updated":
+        this.checkValidity();
+        break;
+      default:
+        break;
+    }
+  }
+
+  /**
+   * Initialize the UI of feed account view.
+   *
+   * @param {string} subview - Subview for which the UI is being initialized.
+   */
+  async #initUI(subview) {
+    this.#currentState = subview;
+    const stateDetails = this.#states[this.#currentState];
+    await this.#loadTemplateScript(stateDetails.templateId);
+
+    // Always dispatch the maximized event to ensure that the account hub is
+    // fully visible when we change subview.
+    this.dispatchEvent(
+      new CustomEvent("request-maximize", {
+        bubbles: true,
+      })
+    );
+
+    this.#setFooterButtons();
+    // Unhide for focus to work.
+    this.#currentSubview.hidden = false;
+    await this.#currentSubview.setState(stateDetails);
+    // Required.
+    this.#dialog.focus();
+  }
+
+  /**
+   * Inits the footer buttons in the footer template.
+   */
+  #setFooterButtons() {
+    const stateDetails = this.#states[this.#currentState];
+    this.#footer.canForward(stateDetails.nextStep);
+    this.#footer.setDirectionalButtonText(
+      "forward",
+      stateDetails.customForwardFluentID
+    );
+    // The footer forward button is enabled since there is a default value.
+    this.#footer.toggleForwardDisabled(!stateDetails.forwardEnabled);
+  }
+
+  /**
+   * Load the template of a subview using the template ID.
+   *
+   * @param {string} templateId - ID of the template that needs to be loaded.
+   */
+  async #loadTemplateScript(templateId) {
+    if (customElements.get(templateId)) {
+      return;
+    }
+
+    // eslint-disable-next-line no-unsanitized/method
+    await import(
+      `chrome://messenger/content/accountcreation/content/widgets/${templateId}.mjs`
+    );
+  }
+
+  /**
+   * Required function for accountHub.js on dialog close.
+   *
+   * @returns {boolean} - If the account hub can remove this view.
+   */
+  reset() {
+    const stateDetails = this.#states[this.#currentState];
+    // Reset the one subview.
+    this.#currentSubview.resetState(stateDetails);
+    this.#footer.toggleForwardDisabled(!stateDetails.forwardEnabled);
+
+    return true;
+  }
+
+  /**
+   * Set the validity error message if necessary.
+   *
+   * @returns {boolean} - True if the name is valid.
+   */
+  checkValidity() {
+    const stateDetails = this.#states[this.#currentState];
+    const stateData = this.#currentSubview.captureState();
+    let valid = false;
+    // Set to default.
+    let l10nErrorId = stateDetails.validityValueMissingFluentID;
+    if (!stateData.accountName) {
+      l10nErrorId = stateDetails.validityValueMissingFluentID;
+    } else if (this.checkAccountNameExists(stateData.accountName)) {
+      l10nErrorId = stateDetails.validityAlreadyExistsFluentID;
+    } else {
+      valid = true;
+    }
+    this.#currentSubview.clearNotifications?.();
+    this.#currentSubview.updateState(valid, l10nErrorId);
+    this.#footer.toggleForwardDisabled(!valid);
+
+    return valid;
+  }
+
+  /**
+   * Check for an existing feed account name.
+   *
+   * @param {string} accountName - Proposed account name.
+   * @returns {boolean} - True if the name exists.
+   */
+  checkAccountNameExists(accountName) {
+    const feedAccountServers = lazy.FeedUtils.getAllRssServerRootFolders();
+    return feedAccountServers.some(
+      server => server.localizedName == accountName
+    );
+  }
+
+  onFinish() {
+    const accountName = this.#currentSubview.captureState().accountName;
+    try {
+      lazy.FeedUtils.createRssAccount(accountName);
+      this.#dialog.close();
+    } catch (error) {
+      const errorNotification = new Error(error);
+      this.#currentSubview.showNotification({
+        fluentTitleId: "account-hub-creation-error-title",
+        error: errorNotification,
+        type: "error",
+      });
+      this.#currentSubview.updateState(true);
+      this.#footer.toggleForwardDisabled(true);
+    }
+  }
+}
+
+customElements.define("account-hub-feed", AccountHubFeed);
