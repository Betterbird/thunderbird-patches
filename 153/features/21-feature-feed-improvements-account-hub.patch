diff --git a/mail/components/accountcreation/content/widgets/feed-account-form.mjs b/mail/components/accountcreation/content/widgets/feed-account-form.mjs
new file mode 100644
--- /dev/null
+++ b/mail/components/accountcreation/content/widgets/feed-account-form.mjs
@@ -0,0 +1,124 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+import { AccountHubStep } from "./account-hub-step.mjs";
+import "./account-hub-input.mjs"; // eslint-disable-line import/no-unassigned-import
+
+/**
+ * Account Hub Feed Account Form.
+ */
+class FeedAccountForm extends AccountHubStep {
+  /**
+   * Default feed account name.
+   *
+   * @type {string}
+   */
+  #defaultAccountName;
+  /**
+   * Custom <account-hub-input> element for feed account.
+   *
+   * @type {HTMLElement}
+   */
+  #feedAccountName;
+
+  /**
+   * Feed account <input> element.
+   *
+   * @type {HTMLElement}
+   */
+  #feedAccountNameInput;
+
+  connectedCallback() {
+    if (this.hasConnected) {
+      return;
+    }
+    this.hasConnected = true;
+
+    super.connectedCallback();
+
+    // Import .ftl files here, after super and before appending the template.
+    this.l10n.addResourceIds([
+      "messenger/accountSettings.ftl",
+      "calendar/preferences.ftl",
+    ]);
+    this.l10n.connectRoot(this);
+
+    const template = document
+      .getElementById("accountHubFeedAccountFormTemplate")
+      .content.cloneNode(true);
+    this.appendChild(template);
+
+    this.showBrandingHeader();
+    this.#feedAccountName = this.querySelector("#feedAccountName");
+    this.#feedAccountNameInput = this.querySelector("#feedAccountNameInput");
+    this.#feedAccountNameInput.addEventListener("input", this);
+  }
+
+  handleEvent(event) {
+    switch (event.type) {
+      case "input":
+        this.#cleanValue();
+        this.dispatchEvent(
+          new CustomEvent("config-updated", { bubbles: true })
+        );
+        break;
+    }
+  }
+
+  /**
+   * Disallow invalid chars.
+   */
+  #cleanValue() {
+    this.#feedAccountNameInput.value = this.#feedAccountNameInput.value
+      /* eslint-disable-next-line no-control-regex */
+      .replace(/[\x00-\x1F\x7F]/g, "")
+      .trimStart();
+  }
+
+  /**
+   * Sets the form when this step is first visited.
+   */
+  async setState(stateDetails) {
+    this.#defaultAccountName = await this.l10n.formatValue([
+      stateDetails.defaultAccountNameFluentID,
+    ]);
+    this.#feedAccountNameInput.value = this.#defaultAccountName;
+    this.#feedAccountNameInput.select();
+    this.#feedAccountNameInput.focus();
+  }
+
+  /**
+   * Updates form for validity errors.
+   */
+  updateState(valid, errorFluentID) {
+    !valid &&
+      this.#feedAccountName.setAttribute("l10n-error-id", errorFluentID);
+    this.#feedAccountName.setErrorState(valid || errorFluentID);
+  }
+
+  /**
+   * Return the current state of the feed account form.
+   *
+   * @returns {object}
+   */
+  captureState() {
+    return {
+      accountName: this.#feedAccountNameInput.value.trim(),
+    };
+  }
+
+  /**
+   * Resets the feed account form.
+   */
+  resetState(stateDetails) {
+    this.querySelector("#feedAccountForm").reset();
+    const l10nErrorId = stateDetails.validityValueMissingFluentID;
+    this.#feedAccountName.setAttribute("l10n-error-id", l10nErrorId);
+    this.#feedAccountNameInput.setCustomValidity("");
+    this.#feedAccountNameInput.value = this.#defaultAccountName;
+    this.#feedAccountNameInput.select();
+  }
+}
+
+customElements.define("feed-account-form", FeedAccountForm);
