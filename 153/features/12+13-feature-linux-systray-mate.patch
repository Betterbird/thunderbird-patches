+static void traySetStatusActive(bool aActive) {
+  if (trayIcon) {
+    gtk_status_icon_set_visible(trayIcon, aActive);
+  }
+  if (ci) {
+    app_indicator_set_status(ci, aActive ? APP_INDICATOR_STATUS_ACTIVE
+                                         : APP_INDICATOR_STATUS_PASSIVE);
+  }
+}
+
+static void traySetIcon(const char* aPath) {
+  if (trayIcon) {
+    gtk_status_icon_set_from_file(trayIcon, aPath);
+  }
+  if (ci) {
+    app_indicator_set_icon(ci, aPath, NULL);
+  }
+}
+
+static void traySetTitle(const char* aTitle) {
+  if (ci) {
+    app_indicator_set_title(ci, aTitle);
+  }
+}
+
+static void traySetTooltip(const char* aTooltip) {
+  if (!useTooltip) {
+    return;
+  }
+  if (trayIcon) {
+    gtk_status_icon_set_tooltip_text(trayIcon, aTooltip);
+  }
+  if (ci) {
+    app_indicator_set_tooltip(ci, NULL /* icon */, aTooltip /* title */, "");
+  }
+}
