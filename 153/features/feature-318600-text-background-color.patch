diff --git a/mail/components/compose/content/editor.js b/mail/components/compose/content/editor.js
--- a/mail/components/compose/content/editor.js
+++ b/mail/components/compose/content/editor.js
@@ -803,8 +803,100 @@ function onBackgroundColorChange() {
     gDefaultBackgroundColor
   );
 }
 
+function onHighlightColorChange() {
+  SetTextBackgroundColorButton(GetTextBackgroundColorState());
+}
+
+function SetTextBackgroundColorButton(color) {
+  const button = document.getElementById("TextBackgroundColorButton");
+  if (button) {
+    button.setAttribute("color", color);
+    if (color == "mixed") {
+      button.style.backgroundColor = "";
+    } else {
+      button.style.backgroundColor = color || "transparent";
+    }
+  }
+}
+
+function GetTextBackgroundColorFromElement(element) {
+  const editor = GetCurrentEditor();
+  const body = GetBodyElement();
+  while (element && element != body) {
+    // Stop at block elements: their background color is not a text background.
+    if (editor.nodeIsBlock(element)) {
+      return "";
+    }
+    let color = element.getAttribute("bgcolor");
+    if (!color) {
+      color = element.style.getPropertyValue("background-color");
+    }
+    if (color) {
+      return ConvertRGBColorIntoHEXColor(color);
+    }
+    element = element.parentElement;
+  }
+  return "";
+}
+
+function GetTextBackgroundColorState() {
+  const editor = GetCurrentEditor();
+  if (!editor || !editor.selection || !IsHTMLEditor()) {
+    return "";
+  }
+  const range = editor.selection.getRangeAt(0);
+  if (!range) {
+    return "";
+  }
+  if (range.collapsed) {
+    let element = range.startContainer;
+    if (element.nodeType != Node.ELEMENT_NODE) {
+      element = element.parentElement;
+    }
+    return GetTextBackgroundColorFromElement(element);
+  }
+
+  // For a non-collapsed selection, report "mixed" if the selected text runs
+  // have different background colors.
+  let root = range.commonAncestorContainer;
+  if (root.nodeType != Node.ELEMENT_NODE) {
+    root = root.parentElement;
+  }
+  const iterator = editor.document.createNodeIterator(
+    root,
+    NodeFilter.SHOW_TEXT,
+    node =>
+      range.intersectsNode(node)
+        ? NodeFilter.FILTER_ACCEPT
+        : NodeFilter.FILTER_REJECT
+  );
+  let firstColor;
+  for (let node = iterator.nextNode(); node; node = iterator.nextNode()) {
+    // Stop once we have walked past the end of the range.
+    if (
+      node.compareDocumentPosition(range.endContainer) &
+      Node.DOCUMENT_POSITION_PRECEDING
+    ) {
+      break;
+    }
+    // Only consider text that is actually part of the range.
+    const start = node == range.startContainer ? range.startOffset : 0;
+    const end = node == range.endContainer ? range.endOffset : node.length;
+    if (end <= start) {
+      continue;
+    }
+    const color = GetTextBackgroundColorFromElement(node.parentElement);
+    if (firstColor === undefined) {
+      firstColor = color;
+    } else if (color != firstColor) {
+      return "mixed";
+    }
+  }
+  return firstColor ?? "";
+}
