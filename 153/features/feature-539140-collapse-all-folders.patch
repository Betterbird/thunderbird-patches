Bug 539140 - Implement 'Collapse All Folders'.

diff --git a/mail/base/content/about3Pane.js b/mail/base/content/about3Pane.js
--- a/mail/base/content/about3Pane.js
+++ b/mail/base/content/about3Pane.js
@@ -8336,8 +8336,23 @@ commandController.registerCallback(
     threadPaneHeader.updateStatusBar();
   },
   () => !!gViewWrapper?.dbView
 );
+commandController.registerCallback(
+  "cmd_collapseAllFolders",
+  () => {
+    folderTree.querySelectorAll("li").forEach(row => {
+      if (
+        !row.classList.contains("unselectable") &&
+        row.classList.contains("children") &&
+        !row.classList.contains("collapsed")
+      ) {
+        folderTree.collapseRow(row);
+      }
+    });
+  },
+  () => !!gViewWrapper?.dbView
+);
 
 function SwitchView(command) {
