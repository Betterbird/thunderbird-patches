+// #define DEBUG_RESTORE 1
+
+// Put a window back where it was. This MUST be called while the window is
+// still unmapped, that is, before `SetVisibility(true)`: `gtk_window_move()`
+// and `gtk_window_resize()` are ignored by the window manager while a window
+// is maximized, so restoring the geometry after the window has been mapped
+// does nothing and a maximized window reappears on whichever monitor the
+// window manager happened to pick. On an unmapped window both calls are
+// recorded by GTK and applied at map time, `gtk_window_move()` as a position
+// hint and `gtk_window_maximize()` as the initial `_NET_WM_STATE`, so the
+// window is mapped maximized on the right monitor straight away, without
+// flicker.
+static void restoreGeometry(GtkWindow* aWindow, const WinDims& aDims) {
+  gtk_window_unmaximize(aWindow);
+  gtk_window_move(aWindow, aDims.x, aDims.y);
+  if (aDims.maximized) {
+    // Don't restore the size, that's the maximized size. Leave the window
+    // manager's idea of the unmaximized geometry alone.
+    gtk_window_maximize(aWindow);
+  } else {
+    gtk_window_resize(aWindow, aDims.w, aDims.h);
+  }
+#ifdef DEBUG_RESTORE
+  fprintf(stderr, "=== Restoring to         %d %d %d %d, maximized %d\n",
+          aDims.x, aDims.y, aDims.w, aDims.h, aDims.maximized);
+#endif
+}
