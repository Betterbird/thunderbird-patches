# HG changeset patch
# User Betterbird <betterbird@betterbird.eu> and DeepSeek
# Date 1787696250 -7200
# Parent  36d517574f8c22d80dc8257253f83ca5a5642de5
Feature: Linux systray. Restore last app window on launch of same application.

diff --git a/mail/components/MessengerContentHandler.sys.mjs b/mail/components/MessengerContentHandler.sys.mjs
--- a/mail/components/MessengerContentHandler.sys.mjs
+++ b/mail/components/MessengerContentHandler.sys.mjs
@@ -111,8 +111,23 @@ async function getOrOpen3PaneWindow() {
   return win;
 }
 
 /**
+ * Restore the main window when a second instance is activating this one and
+ * the main window was hidden in the system tray.
+ */
+function restoreHiddenMainWindowLinux() {
+  if (AppConstants.platform == "linux") {
+    const win = Services.wm.getMostRecentWindow("mail:3pane");
+    if (win) {
+      Cc["@mozilla.org/messenger/osintegration;1"]
+        .getService(Ci.nsIMessengerUnixIntegration)
+        .showWindow(win);
+    }
+  }
+}
+
+/**
  * Open the given uri.
  *
  * @param {nsIURI} uri - The uri to open.
  */
@@ -379,23 +394,27 @@ export class MessengerContentHandler {
     // indicates that this startup is due to MAPI. Don't do anything for now.
     cmdLine.handleFlag("MapiStartup", false);
 
     if (cmdLine.handleFlag("mail", false)) {
+      restoreHiddenMainWindowLinux();
       getOrOpen3PaneWindow().then(win => win.focusOnMail(0));
       cmdLine.preventDefault = true;
     }
 
     if (cmdLine.handleFlag("addressbook", false)) {
+      restoreHiddenMainWindowLinux();
       getOrOpen3PaneWindow().then(win => win.toAddressBook());
       cmdLine.preventDefault = true;
     }
 
     if (cmdLine.handleFlag("options", false)) {
+      restoreHiddenMainWindowLinux();
       getOrOpen3PaneWindow().then(win => win.openPreferencesTab());
       cmdLine.preventDefault = true;
     }
 
     if (cmdLine.handleFlag("calendar", false)) {
+      restoreHiddenMainWindowLinux();
       getOrOpen3PaneWindow().then(win => win.toCalendar());
       cmdLine.preventDefault = true;
     }
 
@@ -500,8 +519,9 @@ export class MessengerContentHandler {
     }
 
     if (!uri && cmdLine.state != Ci.nsICommandLine.STATE_INITIAL_LAUNCH) {
       try {
+        restoreHiddenMainWindowLinux();
         for (const window of Services.wm.getEnumerator("mail:3pane")) {
           window.focus();
           return;
         }
