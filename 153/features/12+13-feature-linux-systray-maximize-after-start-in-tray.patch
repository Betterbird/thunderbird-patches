@@ -504,8 +542,17 @@ nsresult nsMessengerUnixIntegration::Hid
       gtk_window_get_size(GTK_WINDOW(gtkWidget), &dims.w, &dims.h);
       // A maximized window can't simply be moved back into place, see
       // restoreGeometry().
       dims.maximized = gtk_window_is_maximized(GTK_WINDOW(gtkWidget));
+      // When the window is hidden during startup, before it has ever been
+      // shown, GTK may not know yet that the window is supposed to be
+      // maximized: the initial maximize request is processed asynchronously
+      // by the window manager and the reply may not have arrived when we get
+      // here. Fall back to the sizemode attribute of the root element, which
+      // AppWindow keeps in sync with the actual window state.
+      if (!dims.maximized) {
+        dims.maximized = windowSizemodeIsMaximized(aWindow);
+      }
