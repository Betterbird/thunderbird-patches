+// `aWindow` is the docshell tree owner of the window to hide. It can hand
+// out the app window it belongs to, which gives access to the window's
+// document. The sizemode attribute of the root element is kept in sync with
+// the actual window state by AppWindow.
+static bool windowSizemodeIsMaximized(nsIBaseWindow* aWindow) {
+  nsCOMPtr<nsIInterfaceRequestor> interfaceRequestor =
+      do_QueryInterface(aWindow);
+  if (!interfaceRequestor) {
+    return false;
+  }
+  nsCOMPtr<nsIAppWindow> appWindow;
+  interfaceRequestor->GetInterface(NS_GET_IID(nsIAppWindow),
+                                   getter_AddRefs(appWindow));
+  if (!appWindow) {
+    return false;
+  }
+  nsCOMPtr<nsIDocShell> docShell;
+  appWindow->GetDocShell(getter_AddRefs(docShell));
+  if (!docShell) {
+    return false;
+  }
+  nsCOMPtr<nsPIDOMWindowOuter> domWindow = docShell->GetWindow();
+  if (!domWindow) {
+    return false;
+  }
+  RefPtr<mozilla::dom::Document> doc = domWindow->GetDoc();
+  if (!doc || !doc->GetDocumentElement()) {
+    return false;
+  }
+  nsAutoString sizemode;
+  doc->GetDocumentElement()->GetAttr(nsGkAtoms::sizemode, sizemode);
+  return sizemode.EqualsLiteral("maximized");
+}
+
