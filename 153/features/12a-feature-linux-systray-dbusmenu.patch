     if (pPrivate->nDbusRegistration != 0)
     {
         g_dbus_connection_unregister_object (pPrivate->pConnection, pPrivate->nDbusRegistration);
@@ -1524,6 +1700,28 @@ static void app_indicator_class_init (AppIndicatorClass *klass)
         }
     }
 
+    if (!m_pMenuNodeInfo)
+    {
+        GError *pError = NULL;
